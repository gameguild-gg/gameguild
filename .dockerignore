# Deny-all, allow-only-what's-needed .dockerignore for building services/web
**/*

# Allow academy app and its contents
!apps/academy/**
apps/academy/node_modules/
apps/academy/.next/

# Allow api app and its contents
!apps/api/**
apps/api/**/bin/
apps/api/**/obj/

# Allow blog app and its contents
!apps/blog/**
apps/blog/node_modules/
apps/blog/.next/

# Allow console app and its contents
!apps/console/**
apps/console/node_modules/
apps/console/.next/

# Allow web app and its contents
!apps/web/**
apps/web/node_modules/
apps/web/.next/

# Allow learning app and its contents
!apps/learning/**
apps/learning/node_modules/
apps/learning/.next/

# Allow ops app and its contents
!apps/ops/**
apps/ops/node_modules/
apps/ops/.next/

# Allow website app and its contents
!apps/website/**
apps/website/node_modules/
apps/website/.next/

# Allow root package files if needed for dependency install/caching
!package.json
!.npmrc
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!turbo.json

# Allow the packages directory and its contents, but exclude node_modules inside it
!packages/**
packages/**/node_modules/

# Allow emception toolchain sources (packages + tsconfigs + coi-serviceworker + scripts + userland)
!tools/emception/package.json
!tools/emception/tsconfig.base.json
!tools/emception/tsconfig.json
!tools/emception/tsconfig.lib.json
!tools/emception/packages/**
tools/emception/packages/**/node_modules/
tools/emception/packages/**/dist/
tools/emception/packages/**/*.tsbuildinfo
!tools/emception/scripts/**
tools/emception/scripts/**/node_modules/
tools/emception/scripts/**/*.tsbuildinfo
!tools/emception/userland/**
# Exclude stale local build artifacts (gitignored locally; .dockerignore
# re-includes them via the userland allowlist above). Without these excludes,
# macOS-specific paths (e.g. /opt/homebrew/...) leak into the Linux container
# and break CPython/LLVM builds.
tools/emception/userland/**/build-*/
tools/emception/userland/**/sysroot-staging/
tools/emception/build/
tools/emception/sysroot/
tools/emception/dist/
tools/emception/tools/emsdk/
tools/emception/public/cdn/
!tools/emception/public/coi-serviceworker.js

# emception-ui package is now used by apps/web — included in build context.
