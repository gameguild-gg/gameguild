{
  "name": "game-guild",
  "version": "0.1.0",
  "description": "GameGuild Platform Monorepo",
  "author": "Matheus Martins <contact@matheusmartins.com>",
  "homepage": "https://gameguild.gg",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @game-guild/api run dev",
    "dev:web": "pnpm --filter @game-guild/web run dev",
    "build": "turbo run build",
    "build:api": "pnpm --filter @game-guild/api run build",
    "build:web": "pnpm --filter @game-guild/web run build",
    "test": "turbo run test",
    "test:api": "pnpm --filter @game-guild/api run test",
    "test:web": "pnpm --filter @game-guild/web run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:api": "pnpm --filter @game-guild/api run lint",
    "lint:web": "pnpm --filter @game-guild/web run lint",
    "format": "pnpm -r run format",
    "generate": "turbo run generate",
    "sync:format": "syncpack format",
    "sync:list": "syncpack list",
    "sync:lint": "syncpack lint",
    "sync:fix": "syncpack fix-mismatches",
    "clean": "rimraf --glob ./**/node_modules ./**/dist ./**/coverage ./**/build ./**/.next ./**/.turbo pnpm-lock.yaml",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@game-guild/eslint-config": "workspace:*",
    "@game-guild/prettier-config": "workspace:*",
    "@game-guild/tailwind-config": "workspace:*",
    "@game-guild/typescript-config": "workspace:*",
    "@next/third-parties": "^15.4.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "next": "^15.4.6",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.0",
    "syncpack": "^12.0.0",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.5.0"
  }
}