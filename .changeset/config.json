{
  "$schema": "https://unpkg.com/@changesets/config@3.0.0/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "gameguild-gg/gameguild"
    }
  ],
  "commit": false,
  "fixed": [
    [
      "emception-workspace",
      "emception",
      "@gameguild/emception-browser",
      "@gameguild/emception-xterm",
      "@gameguild/emception-react",
      "@gameguild/emception-webcomponent",
      "@gameguild/emception-ide",
      "@gameguild/emception-demo-next",
      "@gameguild/emception-demo-react",
      "@gameguild/emception-demo-run-react",
      "@gameguild/emception-demo-run-webcomponent"
    ]
  ],
  "linked": [
    [
      "@game-guild/eslint-config",
      "@game-guild/prettier-config",
      "@game-guild/typescript-config",
      "@game-guild/tailwind-config",
      "@game-guild/jest-config"
    ]
  ],
  "access": "restricted",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [
    "@game-guild/web"
  ],
  "privatePackages": {
    "version": true,
    "tag": false
  }
}
