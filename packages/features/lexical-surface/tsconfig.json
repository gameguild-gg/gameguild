{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@game-guild/typescript-config/react.library.tsconfig.json",
  "display": "Lexical Surface",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitOverride": false,
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noUncheckedIndexedAccess": false,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "paths": {
      "@game-guild/lexical-surface": ["./src/index.ts"],
      "@game-guild/lexical-surface/*": ["./src/*"]
    }
  },
  "include": [
    "src/index.ts",
    "src/adapters.tsx",
    "src/features.ts",
    "src/features.test.ts",
    "src/lexical-surface.tsx",
    "src/theme.ts",
    "src/dialogs/base-confirm-dialog.tsx",
    "src/dialogs/delete-confirm-dialog.tsx",
    "src/lib/client-only-lazy.tsx",
    "src/lexical/**/*.ts",
    "src/lexical/**/*.tsx",
    "src/admonition/**/*.ts",
    "src/admonition/**/*.tsx",
    "src/button/**/*.ts",
    "src/button/**/*.tsx",
    "src/code-action/**/*.ts",
    "src/code-action/**/*.tsx",
    "src/collapsible/**/*.ts",
    "src/collapsible/**/*.tsx",
    "src/context-menu/**/*.ts",
    "src/context-menu/**/*.tsx",
    "src/divider/**/*.ts",
    "src/divider/**/*.tsx",
    "src/draggable/**/*.ts",
    "src/draggable/**/*.tsx",
    "src/embeds/**/*.ts",
    "src/embeds/**/*.tsx",
    "src/emoji/**/*.ts",
    "src/emoji/**/*.tsx",
    "src/equation/**/*.ts",
    "src/equation/**/*.tsx",
    "src/excalidraw/**/*.ts",
    "src/excalidraw/**/*.tsx",
    "src/floating/**/*.ts",
    "src/floating/**/*.tsx",
    "src/icons/**/*.ts",
    "src/icons/**/*.tsx",
    "src/layout/**/*.ts",
    "src/layout/**/*.tsx",
    "src/media/**/*.ts",
    "src/media/**/*.tsx",
    "src/mermaid/**/*.ts",
    "src/mermaid/**/*.tsx",
    "src/nodes/**/*.ts",
    "src/nodes/**/*.tsx",
    "src/page/**/*.ts",
    "src/page/**/*.tsx",
    "src/picker/**/*.ts",
    "src/picker/**/*.tsx",
    "src/shared/**/*.ts",
    "src/shared/**/*.tsx",
    "src/shortcuts/**/*.ts",
    "src/shortcuts/**/*.tsx",
    "src/sticky/**/*.ts",
    "src/sticky/**/*.tsx",
    "src/table/**/*.ts",
    "src/table/**/*.tsx",
    "src/toolbar/**/*.ts",
    "src/toolbar/**/*.tsx",
    "src/vega-lite/**/*.ts",
    "src/vega-lite/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist"],
  "files": [],
  "references": []
}
