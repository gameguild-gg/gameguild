{
  "name": "@game-guild/lexical-surface",
  "version": "4.0.0",
  "type": "module",
  "description": "Reusable Lexical rich-document editing surface for GameGuild",
  "license": "UNLICENSED",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./admonition": "./src/admonition/index.ts",
    "./button": "./src/button/index.ts",
    "./collapsible": "./src/collapsible/index.ts",
    "./divider": "./src/divider/index.ts",
    "./embeds": "./src/embeds/index.ts",
    "./equation": "./src/equation/index.ts",
    "./excalidraw": "./src/excalidraw/index.ts",
    "./layout": "./src/layout/index.ts",
    "./media": "./src/media/index.ts",
    "./mermaid": "./src/mermaid/index.ts",
    "./page": "./src/page/index.ts",
    "./sticky": "./src/sticky/index.ts",
    "./table": "./src/table/index.ts",
    "./vega-lite": "./src/vega-lite/index.ts",
    "./dialogs/*": "./src/dialogs/*.tsx",
    "./nodes/*": "./src/nodes/*.tsx",
    "./support/math/*": "./src/support/math/*.tsx",
    "./*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@floating-ui/react": "^0.27.19",
    "@game-guild/ui": "workspace:^",
    "@lexical/clipboard": "^0.49.0",
    "@lexical/code": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@lexical/table": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@monaco-editor/react": "^4.7.0",
    "d3-dsv": "^3.0.1",
    "katex": "^0.18.1",
    "lexical": "^0.49.0",
    "lucide-react": "^0.525.0",
    "mathlive": "^0.110.0",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.56.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.1",
    "vega-themes": "^3.0.0"
  },
  "devDependencies": {
    "@game-guild/typescript-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
