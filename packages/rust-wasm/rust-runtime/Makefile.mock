# Makefile for mock mrustc (for testing infrastructure)

CXX = em++

CXXFLAGS = -std=c++17 -O2
EMFLAGS = -s ALLOW_MEMORY_GROWTH=1 \
          -s TOTAL_MEMORY=64MB \
          -s MODULARIZE=1 \
          -s EXPORT_ES6=1 \
          -s EXPORT_NAME=mrustcModule \
          -s EXPORTED_RUNTIME_METHODS="['ccall','cwrap']" \
          -s WASM=1 \
          --bind

SRC = mrustc-mock.cpp
OUTPUT = ../public/rust/mrustc.js

all:
	@echo "Building mock mrustc WASM..."
	$(CXX) $(CXXFLAGS) $(EMFLAGS) $(SRC) -o $(OUTPUT)
	@echo "✓ Built: $(OUTPUT)"
	@echo ""
	@echo "Creating wrapper script..."
	@echo "// Rust compiler WASM module loader" > ../public/rust/main.js
	@echo "import mrustcModule from './mrustc.js'" >> ../public/rust/main.js
	@echo "" >> ../public/rust/main.js
	@echo "console.log('[Rust] Loading mrustc runtime...')" >> ../public/rust/main.js
	@echo "" >> ../public/rust/main.js
	@echo "mrustcModule().then(module => {" >> ../public/rust/main.js
	@echo "  window.RustCompiler = {" >> ../public/rust/main.js
	@echo "    compileRust: module.compileRust," >> ../public/rust/main.js
	@echo "    compileRustMulti: module.compileRustMulti" >> ../public/rust/main.js
	@echo "  }" >> ../public/rust/main.js
	@echo "  console.log('[Rust] ✓ Compiler ready')" >> ../public/rust/main.js
	@echo "}).catch(err => {" >> ../public/rust/main.js
	@echo "  console.error('[Rust] Failed to load:', err)" >> ../public/rust/main.js
	@echo "})" >> ../public/rust/main.js
	@echo ""
	@echo "✓ Mock compiler ready for testing!"
	@echo "Run: npm run build && cd ../../apps/web && npm run dev"

clean:
	rm -f $(OUTPUT) ../public/rust/mrustc.wasm

test:
	@echo "Testing WASM module..."
	@node --input-type=module -e "import m from './$(OUTPUT)'; m().then(mod => { console.log('Testing...'); const r = mod.ccall('compile_rust', 'string', ['string', 'string'], ['fn main() { println!(\"Hi\") }', '{}']); console.log('Result:', r); })"
