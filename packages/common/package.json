{
  "name": "@game-guild/common",
  "version": "3.11.0",
  "type": "module",
  "description": "Common utilities and types for GameGuild",
  "author": "GameGuild <contact@gameguild.gg>",
  "homepage": "https://gameguild.gg",
  "license": "UNLICENSED",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "check:types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "format": "prettier --write src",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@game-guild/ui": "*",
    "ethers": "^6.15.0"
  },
  "devDependencies": {
    "@game-guild/eslint-config": "*",
    "@game-guild/prettier-config": "*",
    "@game-guild/tailwind-config": "*",
    "@game-guild/typescript-config": "*",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.5.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0"
  }
}
