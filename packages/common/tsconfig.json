{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@game-guild/typescript-config/tsconfig.react.json",
  "display": "Common",
  "files": [],
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
