{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
      "noEmit": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "emception": ["./packages/core/src/index.ts"],
      "emception/*": ["./packages/core/src/*"],
      "@gameguild/emception-browser": ["./packages/browser/src/index.ts"],
      "@gameguild/emception-browser/*": ["./packages/browser/src/*"],
      "@gameguild/emception-xterm": ["./packages/xterm/src/index.ts"],
      "@gameguild/emception-xterm/*": ["./packages/xterm/src/*"],
      "@gameguild/emception-react": ["./packages/react/src/index.tsx"],
      "@gameguild/emception-react/*": ["./packages/react/src/*"],
      "@gameguild/emception-webcomponent": ["./packages/webcomponent/src/index.ts"],
      "@gameguild/emception-webcomponent/*": ["./packages/webcomponent/src/*"],
      "@gameguild/emception-ide": ["./packages/ide/src/index.ts"],
      "@gameguild/emception-ide/*": ["./packages/ide/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "e2e", "build"],
  "files": [],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/browser" },
    { "path": "packages/xterm" },
    { "path": "packages/react" },
    { "path": "packages/webcomponent" },
    { "path": "packages/ide" }
  ]
}
