{
  "name": "browser-toolchain",
  "version": "0.1.0",
  "private": true,
  "description": "Emscripten C/C++ toolchain running in the browser via WebAssembly",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "clean": "tsx scripts/clean.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "build:emsdk": "tsx scripts/setup-emsdk.ts",
    "build:binaryen": "tsx scripts/build-binaryen.ts",
    "build:cpython": "tsx scripts/build-cpython.ts",
    "build:llvm": "tsx scripts/build-llvm.ts",
    "build:sysroot": "tsx scripts/populate-sysroot.ts",
    "build:manifest": "SKIP_BROTLI=1 tsx scripts/generate-manifest.ts",
    "build:bundles": "tsx scripts/generate-bundles.ts",
    "patch:glue": "tsx scripts/patch-glue.ts",
    "deploy:cdn": "tsx scripts/deploy-cdn.ts",
    "build:all": "run-s typecheck build:emsdk build:binaryen build:cpython build:llvm build:sysroot patch:glue build:manifest build:bundles deploy:cdn",
    "build:pipeline": "npm run clean && run-s build:sysroot build:manifest build:bundles"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "brotli-wasm": "^3.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "monaco-editor": "^0.55.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/shelljs": "^0.10.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cli-progress": "^3.12.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "npm-run-all": "^4.1.5",
    "raw-loader": "^4.0.2",
    "shelljs": "^0.10.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}