{
  "name": "emception",
  "version": "3.0.1",
  "description": "Emscripten C/C++ toolchain running in the browser via WebAssembly",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./worker": {
      "import": "./dist/worker-entry.js",
      "types": "./dist/worker-entry.d.ts"
    }
  },
  "files": [
    "dist",
    "public/cdn",
    "README.md",
    "LICENSE*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gameguild-gg/gameguild.git",
    "directory": "tools/emception"
  },
  "scripts": {
    "build:lib": "tsup && tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build:lib",
    "typecheck": "tsc --noEmit",
    "clean": "tsx scripts/clean.ts",
    "build:emsdk": "tsx scripts/setup-emsdk.ts",
    "build:binaryen": "tsx scripts/build-binaryen.ts",
    "build:cpython": "tsx scripts/build-cpython.ts",
    "build:llvm": "tsx scripts/build-llvm.ts",
    "build:libcurl-lite": "tsx scripts/build-libcurl-lite.ts",
    "build:ninja": "tsx scripts/build-ninja.ts",
    "build:cmake": "tsx scripts/build-cmake.ts",
    "build:sdl3": "tsx scripts/build-sdl3.ts",
    "build:imgui": "tsx scripts/build-imgui.ts",
    "build:sysroot": "tsx scripts/populate-sysroot.ts",
    "build:manifest": "tsx scripts/generate-manifest.ts",
    "build:brotli": "tsx scripts/build-brotli.ts",
    "build:bundles": "tsx scripts/generate-bundles.ts",
    "patch:glue": "tsx scripts/patch-glue.ts",
    "deploy:cdn": "tsx scripts/deploy-cdn.ts",
    "build:all": "run-s typecheck build:emsdk build:binaryen build:cpython build:llvm build:libcurl-lite build:ninja build:cmake build:sdl3 build:imgui build:sysroot build:brotli patch:glue build:manifest build:bundles build:lib deploy:cdn",
    "build:cdn": "run-s build:manifest build:bundles deploy:cdn",
    "build:pipeline": "run-s build:sysroot build:brotli patch:glue build:cdn build:lib",
    "e2e": "npx playwright test --config=playwright.config.ts",
    "e2e:react": "npx playwright test --config=playwright.config.react.ts"
  },
  "dependencies": {},
  "peerDependencies": {
    "@xterm/xterm": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@xterm/xterm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20",
    "@types/shelljs": "^0.10.0",
    "@xterm/xterm": "^6.0.0",
    "cli-progress": "^3.12.0",
    "npm-run-all": "^4.1.5",
    "shelljs": "^0.10.0",
    "tsup": "^8.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
