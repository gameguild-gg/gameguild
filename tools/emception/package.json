{
  "version": "4.2.0",
  "name": "emception-workspace",
  "description": "Emscripten C/C++ toolchain running in the browser via WebAssembly",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "emception": "./bin/emception.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./worker": {
      "import": "./dist/worker-entry.js",
      "types": "./dist/worker-entry.d.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "public/cdn",
    "README.md",
    "LICENSE*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gameguild-gg/gameguild.git",
    "directory": "tools/emception"
  },
  "scripts": {
    "build:lib": "tsup && tsc -p tsconfig.lib.json",
    "prepublishOnly": "pnpm run build:lib",
    "stage:core:cdn": "node scripts/stage-core-cdn.mjs",
    "stage:toolchain:cdn": "node scripts/stage-toolchain-cdn.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "tsx scripts/clean.ts",
    "build:emsdk": "tsx scripts/setup-emsdk.ts",
    "build:binaryen": "tsx scripts/build-binaryen.ts",
    "build:cpython": "tsx scripts/build-cpython.ts",
    "build:llvm": "tsx scripts/build-llvm.ts",
    "build:libcurl-lite": "tsx scripts/build-libcurl-lite.ts",
    "build:cmake": "tsx scripts/build-cmake.ts",
    "build:sdl3": "tsx scripts/build-sdl3.ts",
    "build:imgui": "tsx scripts/build-imgui.ts",
    "build:raylib": "tsx scripts/build-raylib.ts",
    "build:allegro": "tsx scripts/build-allegro.ts",
    "build:sysroot": "tsx scripts/populate-sysroot.ts",
    "build:stage:sysroot": "node scripts/stage-sysroot.mjs",
    "build:manifest": "tsx scripts/generate-manifest.ts",
    "build:brotli": "tsx scripts/build-brotli.ts",
    "build:bundles": "tsx scripts/generate-bundles.ts",
    "build:assert-no-dupes": "tsx scripts/assert-no-duplicate-hashes.ts",
    "patch:glue": "tsx scripts/patch-glue.ts",
    "deploy:cdn": "tsx scripts/deploy-cdn.ts",
    "build:emscripten:warmup": "tsx scripts/warmup-emscripten-cache.ts",
    "build:toolchain:light": "run-p build:libcurl-lite build:cmake",
    "build:toolchain:heavy": "run-s build:binaryen build:cpython build:llvm",
    "build:toolchain:parallel": "run-s build:toolchain:light build:toolchain:heavy",
    "build:graphics:parallel": "run-s build:imgui build:raylib build:allegro",
    "build:graphics": "run-s build:sdl3 build:graphics:parallel",
    "build:cdn:serial": "run-s build:sysroot build:stage:sysroot patch:glue build:manifest build:brotli build:bundles build:assert-no-dupes build:lib deploy:cdn stage:toolchain:cdn stage:core:cdn",
    "build:all": "run-s build:packages:core build:packages:xterm build:packages:browser typecheck build:emsdk build:emscripten:warmup build:toolchain:parallel build:graphics build:cdn:serial",
    "build:cdn": "run-s patch:glue build:manifest build:brotli build:bundles build:assert-no-dupes deploy:cdn stage:toolchain:cdn stage:core:cdn",
    "build:pipeline": "run-s build:stage:sysroot build:cdn build:lib",
    "build:packages": "run-s build:packages:core build:packages:xterm build:packages:browser build:packages:react build:packages:webcomponent build:packages:ide",
    "build:packages:core": "cd packages/core && tsc -p tsconfig.json",
    "build:packages:browser": "cd packages/browser && tsc -p tsconfig.json && cp src/emscripten/subprocess_shim.py dist/emscripten/subprocess_shim.py && cp ../../public/coi-serviceworker.js dist/coi-serviceworker.js",
    "build:packages:xterm": "cd packages/xterm && tsc -p tsconfig.json",
    "build:packages:react": "cd packages/react && tsc -p tsconfig.json",
    "build:packages:webcomponent": "cd packages/webcomponent && tsc -p tsconfig.json",
    "build:packages:ide": "cd packages/ide && tsc -p tsconfig.json",
    "test:scripts": "node scripts/run-node-tests.mjs scripts/tests",
    "test:packages": "run-s test:scripts test:packages:core test:packages:browser test:packages:webcomponent test:packages:ide",
    "test:packages:core": "pnpm --filter emception test",
    "test:packages:browser": "pnpm --filter @gameguild/emception-browser test",
    "test:types:packages": "pnpm --filter emception run test:types",
    "test:packages:webcomponent": "pnpm --filter @gameguild/emception-webcomponent test",
    "test:packages:ide": "pnpm --filter @gameguild/emception-ide test",
    "typecheck:packages": "run-s typecheck:packages:core typecheck:packages:browser typecheck:packages:xterm typecheck:packages:react typecheck:packages:webcomponent typecheck:packages:ide",
    "typecheck:packages:core": "pnpm --filter emception run typecheck",
    "typecheck:packages:browser": "pnpm --filter @gameguild/emception-browser run typecheck",
    "typecheck:packages:xterm": "pnpm --filter @gameguild/emception-xterm run typecheck",
    "typecheck:packages:react": "pnpm --filter @gameguild/emception-react run typecheck",
    "typecheck:packages:webcomponent": "pnpm --filter @gameguild/emception-webcomponent run typecheck",
    "typecheck:packages:ide": "pnpm --filter @gameguild/emception-ide run typecheck",
    "clean:packages": "run-s clean:packages:*",
    "clean:packages:core": "pnpm --filter emception run clean",
    "clean:packages:browser": "pnpm --filter @gameguild/emception-browser run clean",
    "clean:packages:xterm": "pnpm --filter @gameguild/emception-xterm run clean",
    "clean:packages:react": "pnpm --filter @gameguild/emception-react run clean",
    "clean:packages:webcomponent": "pnpm --filter @gameguild/emception-webcomponent run clean",
    "clean:packages:ide": "pnpm --filter @gameguild/emception-ide run clean",
    "e2e": "npx playwright test --config=playwright.config.ts",
    "e2e:react": "npx playwright test --config=playwright.config.react.ts"
  },
  "dependencies": {
    "@gameguild/emception-browser": "*",
    "@gameguild/emception-xterm": "*"
  },
  "peerDependencies": {
    "@xterm/xterm": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@xterm/xterm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20",
    "@types/shelljs": "^0.10.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@xterm/xterm": "^6.0.0",
    "cli-progress": "^3.12.0",
    "npm-run-all": "^4.1.5",
    "shelljs": "^0.10.0",
    "tsd": "^0.33.0",
    "tsup": "^8.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^8.2.1"
  }
}
