{
  "name": "@emception/core",
  "version": "3.2.1",
  "description": "Runtime-agnostic core: types, EmceptionCore, VFS, tool registry, build resolver, test engine, presets, RuntimeAdapter.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./errors": {
      "import": "./dist/errors.js",
      "types": "./dist/errors.d.ts"
    },
    "./presets": {
      "import": "./dist/presets.js",
      "types": "./dist/presets.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test 'tests/*.test.mjs'",
    "test:types": "npm run build && tsd",
    "clean": "rm -rf dist"
  },
  "tsd": {
    "directory": ".",
    "compilerOptions": {
      "moduleResolution": "node16",
      "module": "node16"
    }
  },
  "devDependencies": {
    "tsd": ">=0.31.0",
    "typescript": "^5.3.0"
  }
}
