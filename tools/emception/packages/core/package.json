{
  "version": "4.1.0",
  "name": "emception",
  "description": "Runtime-agnostic core: types, EmceptionCore, VFS, tool registry, build resolver, test engine, presets, RuntimeAdapter.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./errors": {
      "import": "./dist/errors.js",
      "types": "./dist/errors.d.ts"
    },
    "./build-presets": {
      "import": "./dist/build-presets.js",
      "types": "./dist/build-presets.d.ts"
    },
    "./workspace-config": {
      "import": "./dist/workspace-config.js",
      "types": "./dist/workspace-config.d.ts"
    },
    "./workspace-presets": {
      "import": "./dist/workspace-presets.js",
      "types": "./dist/workspace-presets.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    },
    "./cdn/manifest.json": "./cdn/manifest.json",
    "./cdn/*": "./cdn/*"
  },
  "files": [
    "dist",
    "cdn",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gameguild-gg/gameguild.git",
    "directory": "tools/emception/packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build && node ../../scripts/stage-core-cdn.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test 'tests/*.test.mjs'",
    "test:types": "npm run build && tsd",
    "clean": "rm -rf dist cdn"
  },
  "tsd": {
    "directory": "test-d",
    "compilerOptions": {
      "moduleResolution": "node16",
      "module": "node16",
      "composite": false
    }
  },
  "devDependencies": {
    "tsd": ">=0.31.0",
    "typescript": "^5.3.0"
  }
}
