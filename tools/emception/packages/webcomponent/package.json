{
  "version": "3.3.1",
  "name": "@gameguild/emception-webcomponent",
  "description": "<emception-run> custom element. No framework deps.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/*.test.mjs'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gameguild/emception-browser": "*",
    "emception": "*"
  },
  "peerDependencies": {
    "@gameguild/emception-xterm": "*"
  },
  "peerDependenciesMeta": {
    "@gameguild/emception-xterm": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
