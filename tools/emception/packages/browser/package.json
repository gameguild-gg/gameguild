{
  "name": "@emception/browser",
  "version": "0.1.0-alpha.0",
  "description": "Browser runtime adapter for emception: Web Worker spawn, IDB workspace store, OffscreenCanvas helpers, COI preflight.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./coi": {
      "import": "./dist/coi/index.js",
      "types": "./dist/coi/index.d.ts"
    },
    "./worker": {
      "import": "./dist/worker-entry.js",
      "types": "./dist/worker-entry.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@emception/core": "0.1.0-alpha.0",
    "@emception/xterm": "0.1.0-alpha.0"
  },
  "peerDependencies": {
    "@emception/sysroot": ">=0.20.0-alpha.0"
  },
  "peerDependenciesMeta": {
    "@emception/sysroot": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
