{
  "name": "@gameguild/emception-xterm",
  "version": "3.11.0",
  "description": "xterm.js stdin/stdout/stderr bridge for emception. xterm peer dep lives here.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gameguild-gg/gameguild.git",
    "directory": "tools/emception/packages/xterm"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/clean-package.mjs dist"
  },
  "dependencies": {
    "emception": "*"
  },
  "peerDependencies": {
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@xterm/xterm": "^6.0.0",
    "typescript": "^5.3.0"
  }
}
