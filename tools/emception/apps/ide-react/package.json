{
  "name": "@gameguild/emception-demo-react",
  "version": "3.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build:lib --prefix ../.. && node ../../scripts/install-app-cdn-from-package.mjs apps/ide-react",
    "dev": "run-p watch:core watch:browser watch:ide vite",
    "vite": "vite",
    "watch:core": "tsc -p ../../packages/core/tsconfig.json --watch --preserveWatchOutput",
    "watch:browser": "tsc -p ../../packages/browser/tsconfig.json --watch --preserveWatchOutput",
    "watch:ide": "tsc -p ../../packages/ide/tsconfig.json --watch --preserveWatchOutput",
    "prebuild": "npm run build:lib --prefix ../.. && node ../../scripts/install-app-cdn-from-package.mjs apps/ide-react",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gameguild/emception-ide": "*",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "emception": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.3.0",
    "vite": "^8.2.1"
  }
}
