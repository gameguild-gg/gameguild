{
  "name": "@gameguild/emception-demo-run-react",
  "version": "3.11.0",
  "private": true,
  "description": "Minimal Vite + React 19 demo for the <EmceptionRun /> declarative wrapper from @gameguild/emception-react.",
  "type": "module",
  "scripts": {
    "predev": "pnpm --dir ../.. run build:packages",
    "dev": "run-p watch:core watch:browser watch:react watch:webcomponent vite",
    "vite": "vite",
    "watch:core": "tsc -p ../../packages/core/tsconfig.json --watch --preserveWatchOutput",
    "watch:browser": "tsc -p ../../packages/browser/tsconfig.json --watch --preserveWatchOutput",
    "watch:react": "tsc -p ../../packages/react/tsconfig.json --watch --preserveWatchOutput",
    "watch:webcomponent": "tsc -p ../../packages/webcomponent/tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gameguild/emception-browser": "*",
    "@gameguild/emception-react": "*",
    "@gameguild/emception-webcomponent": "*",
    "emception": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.3.0",
    "vite": "^6.3.5"
  }
}
