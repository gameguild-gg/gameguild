{
  "name": "@gameguild/emception-demo-run-webcomponent",
  "version": "3.11.0",
  "private": true,
  "description": "Minimal Vite + vanilla HTML demo for the <emception-run> custom element from @gameguild/emception-webcomponent.",
  "type": "module",
  "scripts": {
    "predev": "pnpm --dir ../.. run build:packages",
    "dev": "run-p watch:core watch:browser watch:webcomponent vite",
    "vite": "vite",
    "watch:core": "tsc -p ../../packages/core/tsconfig.json --watch --preserveWatchOutput",
    "watch:browser": "tsc -p ../../packages/browser/tsconfig.json --watch --preserveWatchOutput",
    "watch:webcomponent": "tsc -p ../../packages/webcomponent/tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gameguild/emception-browser": "*",
    "@gameguild/emception-webcomponent": "*",
    "emception": "*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^6.3.5"
  }
}
