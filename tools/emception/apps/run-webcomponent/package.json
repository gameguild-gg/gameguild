{
  "name": "@gameguild/emception-demo-run-webcomponent",
  "version": "3.5.0",
  "private": true,
  "description": "Minimal Vite + vanilla HTML demo for the <emception-run> custom element from @gameguild/emception-webcomponent.",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/install-app-cdn-from-package.mjs apps/run-webcomponent",
    "dev": "vite",
    "prebuild": "node ../../scripts/install-app-cdn-from-package.mjs apps/run-webcomponent",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gameguild/emception-browser": "*",
    "@gameguild/emception-webcomponent": "*",
    "emception": "*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^6.3.5"
  }
}
