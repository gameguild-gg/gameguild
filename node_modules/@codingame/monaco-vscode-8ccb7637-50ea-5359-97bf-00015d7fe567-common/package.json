    "@codingame/monaco-vscode-897bebad-39df-57cb-8a57-36a271d038be-common": "23.3.0",
    "@codingame/monaco-vscode-api": "23.3.0"
  },
  "exports": {
    ".": {
      "default": "./empty.js"
    },
    "./vscode/*.css": {
      "default": "./vscode/src/*.css"
    },
    "./vscode/*": {
      "types": "./vscode/src/*.d.ts",
      "default": "./vscode/src/*.js"
    },
    "./*": {
      "types": "./*.d.ts",
      "default": "./*.js"
    }
  },
  "typesVersions": {
    "*": {
      "vscode/*": [
        "./vscode/src/*.d.ts"
      ]
    }
  }
}