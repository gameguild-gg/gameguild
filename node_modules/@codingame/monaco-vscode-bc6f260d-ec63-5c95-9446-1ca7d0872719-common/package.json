{
  "name": "@codingame/monaco-vscode-bc6f260d-ec63-5c95-9446-1ca7d0872719-common",
  "version": "23.3.0",
  "private": false,
  "description": "VSCode public API plugged on the monaco editor - common package (editor.api, chat, extensions, interactive, multi-diff-editor, notebook, scm)",
  "keywords": [],
  "author": {
    "name": "CodinGame",
    "url": "http://www.codingame.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/CodinGame/monaco-vscode-api.git"
  },
  "type": "module",
  "dependencies": {
    "@codingame/monaco-vscode-3b5a5cd1-d4ff-500a-b609-57e0cd4afa0a-common": "23.3.0",
    "@codingame/monaco-vscode-aac7027b-326c-513a-95a9-e4eedd151b38-common": "23.3.0",
    "@codingame/monaco-vscode-api": "23.3.0"
  },
  "exports": {
    ".": {
      "default": "./empty.js"
    },
    "./vscode/*.css": {
      "default": "./vscode/src/*.css"
    },
    "./vscode/*": {
      "types": "./vscode/src/*.d.ts",
      "default": "./vscode/src/*.js"
    },
    "./*": {
      "types": "./*.d.ts",
      "default": "./*.js"
    }
  },
  "typesVersions": {
    "*": {
      "vscode/*": [
        "./vscode/src/*.d.ts"
      ]
    }
  }
}