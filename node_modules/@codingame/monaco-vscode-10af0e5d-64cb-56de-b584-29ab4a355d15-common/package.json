{
  "name": "@codingame/monaco-vscode-10af0e5d-64cb-56de-b584-29ab4a355d15-common",
  "version": "23.3.0",
  "private": false,
  "description": "VSCode public API plugged on the monaco editor - common package (chat, extensions, interactive, notebook, task, terminal, testing)",
  "keywords": [],
  "author": {
    "name": "CodinGame",
    "url": "http://www.codingame.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/CodinGame/monaco-vscode-api.git"
  },
  "type": "module",
  "dependencies": {},
  "exports": {
    ".": {
      "default": "./empty.js"
    },
    "./vscode/*.css": {
      "default": "./vscode/src/*.css"
    },
    "./vscode/*": {
      "types": "./vscode/src/*.d.ts",
      "default": "./vscode/src/*.js"
    },
    "./*": {
      "types": "./*.d.ts",
      "default": "./*.js"
    }
  },
  "typesVersions": {
    "*": {
      "vscode/*": [
        "./vscode/src/*.d.ts"
      ]
    }
  }
}