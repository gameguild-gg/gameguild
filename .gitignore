# Repository-wide ignore rules

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Editors and IDEs
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/

# Cache and temp files
.cache/
.temp/
.tmp/

# Package manager state
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment files
.env
.env.*
!.env.example
!.env.*.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Generic build and test output
build/
dist/
coverage/
test-results/
playwright-report/
playwright-report-react/
*.tsbuildinfo

# Miscellaneous
*.pem

# Embedded upstream repos
tools/emception/userland/**/.git/
tools/emception/userland/**/

.next/
