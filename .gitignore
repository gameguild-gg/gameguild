# Repository-wide ignore rules

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
nul

# Editors and IDEs
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/

# Cache and temp files
.cache/
.temp/
.tmp/

# Package manager state
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json
yarn.lock
pnpm-lock.yaml
.pnpm-store/

# Environment files
.env
.env.*
!.env.example
!.env.*.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Generic build and test output
build/
dist/
coverage/
test-results/
playwright-report/
playwright-report-react/
artifacts/
*.tsbuildinfo
apps/web/test-results/

# .NET
/bin/
/obj/
*.user
*.suo
*.cache
*.docstates
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
x64/
x86/
*.exe
*.dll
*.pdb
/[Tt]estResults/
/[Ll]ogs/

# Next.js
next-env.d.ts
.next/
/out/

# Vercel
.vercel

# Turbo
.turbo

# Public assets generated at build time
public/pyodide/*
public/wasm/*

# Embedded upstream repos (avoid nested .git metadata/tooling conflicts)
tools/emception/userland/**/.git/

# Miscellaneous
*.pem
.superpowers/

# Security: infra/ contains secrets (CF tokens, origin certs, kubeconfig, ansible vault)
# Repo is PUBLIC — infra must NEVER be tracked
infra/
.omo/