# Repository-wide ignore rules

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Editors and IDEs
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/

# Cache and temp files
.cache/
.temp/
.tmp/

# Package manager state
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Ignore nested workspace lock files (only root package-lock.json is tracked)
**/package-lock.json
!/package-lock.json
**/yarn.lock
!/yarn.lock
**/pnpm-lock.yaml
!/pnpm-lock.yaml

# Environment files
.env
.env.*
!.env.example
!.env.*.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Generic build and test output
build/
dist/
coverage/
test-results/
playwright-report/
playwright-report-react/
*.tsbuildinfo

# Miscellaneous
*.pem

# Embedded upstream repos (extracted source trees only — hand-written wrappers
# under userland/<pkg>/ must remain tracked). Per-package ignores live in
# tools/emception/.gitignore.
tools/emception/userland/**/.git/

.next/

data/state_store.db/

data/stream_store/
