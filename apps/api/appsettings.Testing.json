{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Security": {
      "Enabled": false,
      "RequireHttps": false,
      "EnforceStrongPasswords": false,
      "RequireEmailVerification": false,
      "LogAllAuthEvents": false,
      "UseBCryptHashing": false,
      "BCryptWorkFactor": 4
    },
    "Anomaly": {
      "Enabled": false,
      "MaxFailedAttemptsPerHour": 1000,
      "MaxFailedAttemptsPerDay": 10000,
      "MaxAttemptsPerIpPerHour": 10000,
      "SuspiciousThreshold": 1000,
      "ThrottleMinutes": 0,
      "LogTimingAnalysis": false,
      "AutoBlockSuspiciousIps": false
    },
    "UserEnumerationProtection": {
      "Enabled": false,
      "MinProcessingTimeMs": 0,
      "MaxProcessingTimeMs": 0,
      "TargetProcessingTimeMs": 0,
      "LogTimingAnalysis": false,
      "PerformDummyHashing": false,
      "DelayVarianceMs": 0
    }
  },
  "Jwt": {
    "SecretKey": "test-256-bit-secret-key-that-is-at-least-32-characters-long-for-testing!",
    "ExpirationMinutes": 1440,
    "RefreshTokenExpirationDays": 365
  },
  "SessionManagement": {
    "SessionLifetime": "365.00:00:00",
    "TrustedDeviceLifetime": "365.00:00:00",
    "MaxSessionsPerUser": 1000,
    "RequireMfaForNewDevice": false,
    "RequireMfaForNewLocation": false
  },
  "RateLimiting": {
    "Enabled": false,
    "DefaultRequestsPerMinute": 10000,
    "DefaultRequestsBurst": 1000,
    "PerUserRequestsPerMinute": 10000,
    "PerIpRequestsPerMinute": 10000,
    "AuthRequestsPerMinute": 1000,
    "GraphQLRequestsPerMinute": 1000,
    "PaymentRequestsPerMinute": 1000
  },
  "GraphQLSecurity": {
    "MaxDepth": 50,
    "MaxComplexity": 10000,
    "MaxFieldSelections": 1000,
    "IntrospectionEnabled": true,
    "EnableQueryAnalysis": false,
    "EnableComplexityAnalysis": false,
    "EnableDepthAnalysis": false,
    "RejectDuplicateFields": false,
    "MaxAliasCount": 1000
  },
  "InputValidation": {
    "EnableInputSanitization": false,
    "EnableSuspiciousContentDetection": false,
    "LogSuspiciousActivity": false,
    "MaxStringLength": 100000,
    "MaxCollectionSize": 10000,
    "MaxRequestSize": 1073741824,
    "MaxFileSize": 1073741824
  },
  "AuditLogging": {
    "Enabled": false,
    "LogSuccessfulOperations": false,
    "LogFailedOperations": false,
    "RetentionDays": 1,
    "EnableRealTimeAlerts": false
  },
  "Encryption": {
    "DefaultKey": "test-32-character-encryption-key!!",
    "KeyRotationDays": 999999
  }
}
