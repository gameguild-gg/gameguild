{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Security": {
      "RequireHttps": true,
      "EnforceStrongPasswords": true,
      "RequireEmailVerification": true,
      "LogAllAuthEvents": true,
      "BCryptWorkFactor": 10
    },
    "Anomaly": {
      "MaxFailedAttemptsPerHour": 5,
      "MaxFailedAttemptsPerDay": 20,
      "MaxAttemptsPerIpPerHour": 50,
      "SuspiciousThreshold": 25,
      "ThrottleMinutes": 15,
      "LogTimingAnalysis": true,
      "AutoBlockSuspiciousIps": false,
      "AutoBlockThreshold": 75,
      "AutoBlockDurationHours": 12
    },
    "UserEnumerationProtection": {
      "MinProcessingTimeMs": 200,
      "MaxProcessingTimeMs": 600,
      "TargetProcessingTimeMs": 350,
      "LogTimingAnalysis": true,
      "DelayVarianceMs": 100
    }
  },
  "Jwt": {
    "SecretKey": "staging-256-bit-secret-key-that-is-at-least-32-characters-long!",
    "ExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "SessionManagement": {
    "SessionLifetime": "2.00:00:00",
    "TrustedDeviceLifetime": "14.00:00:00",
    "MaxSessionsPerUser": 5,
    "RequireMfaForNewDevice": true,
    "RequireMfaForNewLocation": false
  },
  "RateLimiting": {
    "DefaultRequestsPerMinute": 80,
    "DefaultRequestsBurst": 15,
    "PerUserRequestsPerMinute": 40,
    "PerIpRequestsPerMinute": 150,
    "AuthRequestsPerMinute": 8,
    "GraphQLRequestsPerMinute": 20,
    "PaymentRequestsPerMinute": 3,
    "UseRedis": true,
    "RedisConnectionString": "localhost:6379",
    "EndpointLimits": {
      "/api/auth/login": {
        "RequestsPerMinute": 5,
        "BurstLimit": 2,
        "WindowSizeMinutes": 5
      },
      "/api/auth/register": {
        "RequestsPerMinute": 3,
        "BurstLimit": 1,
        "WindowSizeMinutes": 10
      },
      "/api/auth/forgot-password": {
        "RequestsPerMinute": 2,
        "BurstLimit": 1,
        "WindowSizeMinutes": 15
      }
    }
  },
  "GraphQLSecurity": {
    "MaxDepth": 10,
    "MaxComplexity": 800,
    "MaxFieldSelections": 80,
    "IntrospectionEnabled": false,
    "RejectDuplicateFields": true,
    "MaxAliasCount": 15
  },
  "InputValidation": {
    "MaxStringLength": 800,
    "MaxCollectionSize": 80,
    "MaxRequestSize": 26214400,
    "AllowedFileExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".pdf",
      ".doc",
      ".docx",
      ".txt"
    ],
    "MaxFileSize": 10485760
  },
  "AuditLogging": {
    "LogSuccessfulOperations": true,
    "RetentionDays": 180,
    "EnableRealTimeAlerts": true,
    "AlertThresholds": {
      "FailedLoginAttempts": 5,
      "SuspiciousActivities": 3,
      "PermissionDenials": 8
    }
  },
  "Encryption": {
    "DefaultKey": "staging-32-character-encryption-key!",
    "KeyRotationDays": 60
  },
  "HealthChecks": {
    "EnableRedisCheck": true,
    "RedisConnectionString": "localhost:6379"
  }
}
