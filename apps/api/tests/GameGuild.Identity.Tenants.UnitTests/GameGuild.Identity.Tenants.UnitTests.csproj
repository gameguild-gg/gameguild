<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>GameGuild.Identity.Tenants.UnitTests</RootNamespace>
    </PropertyGroup>

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- COVERAGE THRESHOLDS - Build will FAIL if coverage drops below these values      -->
    <!-- Run with: dotnet test /p:CollectCoverage=true                                   -->
    <!-- Targets: Line 90%, Branch 80%, Method 85% - Industry standard for production   -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <PropertyGroup>
        <!-- Enable coverage collection when /p:CollectCoverage=true is passed -->
        <CollectCoverage>false</CollectCoverage>
        <CoverletOutputFormat>cobertura</CoverletOutputFormat>
        <CoverletOutput>./TestResults/GameGuild.Identity.Tenants.UnitTests.Coverage.xml</CoverletOutput>

        <!-- Minimum coverage thresholds (build fails if not met) -->
        <!-- Line: 90% - Most statements should be executed         -->
        <!-- Branch: 80% - Most conditional paths should be tested  -->
        <!-- Method: 85% - Most functions should be called          -->
        <!-- Note: 100% coverage is often impractical due to:       -->
        <!--   - Compiler-generated async state machines            -->
        <!--   - Interface declarations (no implementation)         -->
        <!--   - Exception paths that are hard to trigger           -->
        <ThresholdType>line,branch,method</ThresholdType>
        <ThresholdStat>total</ThresholdStat>
        
        <!-- Per-metric thresholds -->
        <Threshold>90,80,85</Threshold>

        <!-- Exclude test files, auto-generated code, and compiler-generated async state machines -->
        <ExcludeByFile>**/*Tests.cs,**/obj/**,**/Migrations/**</ExcludeByFile>
        
        <!-- Exclude compiler-generated code (async state machines, closures) -->
        <ExcludeByAttribute>CompilerGenerated,GeneratedCodeAttribute</ExcludeByAttribute>

        <!-- Include only the Identity.Tenants module in coverage -->
        <Include>[GameGuild.Identity.Tenants]*</Include>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.msbuild" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Moq" />
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="AutoFixture" />
        <PackageReference Include="AutoFixture.Xunit2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Identity.Tenants\GameGuild.Identity.Tenants.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.SharedKernel\GameGuild.SharedKernel.csproj" />
        <ProjectReference Include="..\..\Source\GameGuild.API\GameGuild.API.csproj" />
    </ItemGroup>

</Project>