<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>GameGuild.Identity.Tenants.UnitTests</RootNamespace>
    </PropertyGroup>

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- COVERAGE THRESHOLDS - Build will FAIL if coverage drops below these values      -->
    <!-- Run with: dotnet test /p:CollectCoverage=true                                   -->
    <!-- Target: 100% coverage - All untested code must be addressed                     -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <PropertyGroup>
        <!-- Enable coverage collection when /p:CollectCoverage=true is passed -->
        <CollectCoverage>false</CollectCoverage>
        <CoverletOutputFormat>cobertura</CoverletOutputFormat>
        <CoverletOutput>./TestResults/GameGuild.Identity.Tenants.UnitTests.Coverage.xml</CoverletOutput>

        <!-- Minimum coverage thresholds (build fails if not met) -->
        <!-- ENFORCED AT 100% - All code must be tested -->
        <Threshold>100</Threshold>
        <ThresholdType>line,branch,method</ThresholdType>
        <ThresholdStat>total</ThresholdStat>

        <!-- Exclude test files and auto-generated code from coverage -->
        <ExcludeByFile>**/*Tests.cs,**/obj/**,**/Migrations/**</ExcludeByFile>

        <!-- Include only the Identity.Tenants module in coverage -->
        <Include>[GameGuild.Identity.Tenants]*</Include>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.msbuild" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Moq" />
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="AutoFixture" />
        <PackageReference Include="AutoFixture.Xunit2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Identity.Tenants\GameGuild.Identity.Tenants.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.SharedKernel\GameGuild.SharedKernel.csproj" />
        <ProjectReference Include="..\..\Source\GameGuild.API\GameGuild.API.csproj" />
    </ItemGroup>

</Project>