<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>GameGuild.Commerce.Subscriptions.UnitTests</RootNamespace>
    </PropertyGroup>

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- COVERAGE THRESHOLDS - Build will FAIL if coverage drops below these values      -->
    <!-- Run with: dotnet test /p:CollectCoverage=true                                   -->
    <!-- Target: 100% coverage - All untested code must be addressed                     -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <PropertyGroup>
        <!-- Enable coverage collection when /p:CollectCoverage=true is passed -->
        <CollectCoverage>false</CollectCoverage>
        <CoverletOutputFormat>cobertura</CoverletOutputFormat>
        <CoverletOutput>./TestResults/GameGuild.Commerce.Subscriptions.UnitTests.Coverage.xml</CoverletOutput>
        
        <!-- Minimum coverage thresholds (build fails if not met) -->
        <!-- ENFORCED AT 100% - All code must be tested -->
        <Threshold>100</Threshold>
        <ThresholdType>line,branch,method</ThresholdType>
        <ThresholdStat>total</ThresholdStat>
        
        <!-- Exclude test files and auto-generated code from coverage -->
        <ExcludeByFile>**/*Tests.cs,**/obj/**,**/Migrations/**</ExcludeByFile>
        
        <!-- Include only the Subscriptions module in coverage -->
        <Include>[GameGuild.Commerce.Subscriptions]*</Include>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector"/>
        <PackageReference Include="coverlet.msbuild"/>
        <PackageReference Include="FluentAssertions"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="Moq"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Commerce.Subscriptions\GameGuild.Commerce.Subscriptions.csproj"/>
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Commerce.Orders\GameGuild.Commerce.Orders.csproj"/>
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Commerce.Billing\GameGuild.Commerce.Billing.csproj"/>
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Commerce.Payments\GameGuild.Commerce.Payments.csproj"/>
        <ProjectReference Include="..\..\Source\Modules\GameGuild.SharedKernel\GameGuild.SharedKernel.csproj"/>
    </ItemGroup>

</Project>
