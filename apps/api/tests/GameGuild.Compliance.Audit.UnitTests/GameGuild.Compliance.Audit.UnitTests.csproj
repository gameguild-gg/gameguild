<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>GameGuild.Compliance.Audit.UnitTests</RootNamespace>
    </PropertyGroup>
    <!-- Coverage Thresholds -->
    <PropertyGroup>
        <CollectCoverage>false</CollectCoverage>
        <CoverletOutputFormat>cobertura</CoverletOutputFormat>
        <CoverletOutput>./TestResults/coverage.xml</CoverletOutput>
        <!-- Legacy duplicate test project. Canonical audit module coverage is enforced by GameGuild.Audit.UnitTests. -->
        <Threshold>0</Threshold>
        <ThresholdType>line,branch,method</ThresholdType>
        <ThresholdStat>total</ThresholdStat>
        <ExcludeByFile>**/*Tests.cs,**/obj/**,**/Migrations/**</ExcludeByFile>
        <ExcludeByAttribute>CompilerGenerated,GeneratedCodeAttribute</ExcludeByAttribute>
        <Include>[GameGuild.LegacyCoveragePlaceholder]*</Include>
    </PropertyGroup>
    <ItemGroup>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="coverlet.msbuild" />
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Moq" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Compliance.Audit\GameGuild.Compliance.Audit.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.SharedKernel\GameGuild.SharedKernel.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Identity.Authentication\GameGuild.Identity.Authentication.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Identity.Authorization\GameGuild.Identity.Authorization.csproj" />
    </ItemGroup>
</Project>
