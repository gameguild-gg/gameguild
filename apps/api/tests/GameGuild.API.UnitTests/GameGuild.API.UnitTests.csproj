<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- COVERAGE THRESHOLDS - Build will FAIL if coverage drops below these values      -->
    <!-- Run with: dotnet test /p:CollectCoverage=true                                   -->
    <!-- Target: 80% coverage - Standard minimum for production code                     -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <PropertyGroup>
        <CollectCoverage>false</CollectCoverage>
        <CoverletOutputFormat>cobertura</CoverletOutputFormat>
        <CoverletOutput>./TestResults/coverage.xml</CoverletOutput>
        <Threshold>80</Threshold>
        <ThresholdType>line,branch,method</ThresholdType>
        <ThresholdStat>total</ThresholdStat>
        <!-- The API host shell is bootstrap/presentation composition validated by unit smoke tests and E2E.
             Module/domain coverage is enforced in each module test project; this project measures API integration handlers. -->
        <ExcludeByFile>**/*Tests.cs,**/obj/**,**/Migrations/**,**/Source/GameGuild.API/Core/Extensions/**,**/Source/GameGuild.API/Core/Setup/**,**/Source/GameGuild.API/Core/Endpoints/**,**/Source/GameGuild.API/Endpoints/**,**/Source/GameGuild.API/Core/Commands/**,**/Source/GameGuild.API/Core/Configuration/**,**/Source/GameGuild.API/Core/WebApplication/**,**/Source/GameGuild.API/Database/SnapshotCourseSeeder.cs,**/Source/GameGuild.API/Database/DesignTimeDbContextFactory.cs,**/Source/GameGuild.API/Database/DatabaseConnectivityProbe.cs,**/Source/GameGuild.API/Core/Context/**,**/Source/GameGuild.API/Core/Controllers/**,**/Source/GameGuild.API/Core/Services/**,**/Source/GameGuild.API/Core/DependencyInjection.cs</ExcludeByFile>
        <ExcludeByAttribute>CompilerGenerated,GeneratedCodeAttribute</ExcludeByAttribute>
        <Include>[GameGuild.API]*</Include>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.msbuild" />
        <PackageReference Include="Moq" />
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="Testcontainers.PostgreSql" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Source\GameGuild.API\GameGuild.API.csproj" />
        <ProjectReference Include="..\..\Source\Modules\GameGuild.Assets\GameGuild.Assets.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

</Project>
