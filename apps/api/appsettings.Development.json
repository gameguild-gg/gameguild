{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PresentationLayer": {
    "EnableRateLimiting": true,
    "EnableCookieSecurity": true
  },
  "CookieSecurity": {
    "RequireHttps": true,
    "RequireSsl": true,
    "SameSitePolicy": "Strict",
    "SecureCookiePolicy": "Always",
    "HttpOnlyPolicy": "Always",
    "CheckConsentNeeded": false,
    "MinimumSameSitePolicy": "Strict",
    "AuthenticationCookieName": "GameGuild.Auth.Dev",
    "AuthenticationCookieExpireTimeSpan": "1.00:00:00",
    "AuthenticationCookieSlidingExpiration": true,
    "SessionCookieName": "GameGuild.Session.Dev",
    "SessionIdleTimeout": "00:30:00",
    "AntiForgeryTokenName": "GameGuild.AntiForgery.Dev"
  },
  "OpenTelemetry": {
    "Environment": "development",
    "EnableConsoleExporter": true,
    "EnableOtlpExporter": false
  },
  "HealthChecks": {
    "EnableDatabaseCheck": true,
    "EnableRedisCheck": false,
    "EnablePaymentProviderChecks": false,
    "EnableKycProviderChecks": false,
    "EnableMemoryCheck": true,
    "MemoryThresholdMB": 2048,
    "EnableDiskSpaceCheck": true,
    "DiskSpaceThresholdGB": 5
  }
}
