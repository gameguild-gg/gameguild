{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Security": {
      "RequireHttps": false,
      "EnforceStrongPasswords": false,
      "RequireEmailVerification": false,
      "BCryptWorkFactor": 4
    },
    "Anomaly": {
      "MaxFailedAttemptsPerHour": 50,
      "MaxFailedAttemptsPerDay": 200,
      "MaxAttemptsPerIpPerHour": 500,
      "SuspiciousThreshold": 100,
      "ThrottleMinutes": 1,
      "LogTimingAnalysis": true,
      "AutoBlockSuspiciousIps": false
    },
    "UserEnumerationProtection": {
      "MinProcessingTimeMs": 50,
      "MaxProcessingTimeMs": 200,
      "TargetProcessingTimeMs": 100,
      "LogTimingAnalysis": true,
      "DelayVarianceMs": 25
    }
  },
  "Jwt": {
    "ExpirationMinutes": 480,
    "RefreshTokenExpirationDays": 30
  },
  "SessionManagement": {
    "SessionLifetime": "24.00:00:00",
    "TrustedDeviceLifetime": "90.00:00:00",
    "MaxSessionsPerUser": 20,
    "RequireMfaForNewDevice": false,
    "RequireMfaForNewLocation": false
  },
  "RateLimiting": {
    "DefaultRequestsPerMinute": 1000,
    "DefaultRequestsBurst": 200,
    "PerUserRequestsPerMinute": 500,
    "PerIpRequestsPerMinute": 2000,
    "AuthRequestsPerMinute": 100,
    "GraphQLRequestsPerMinute": 300,
    "PaymentRequestsPerMinute": 50,
    "EndpointLimits": {
      "/api/auth/login": {
        "RequestsPerMinute": 50,
        "BurstLimit": 20,
        "WindowSizeMinutes": 1
      },
      "/api/auth/register": {
        "RequestsPerMinute": 20,
        "BurstLimit": 10,
        "WindowSizeMinutes": 1
      },
      "/api/auth/forgot-password": {
        "RequestsPerMinute": 10,
        "BurstLimit": 5,
        "WindowSizeMinutes": 1
      }
    }
  },
  "GraphQLSecurity": {
    "MaxDepth": 20,
    "MaxComplexity": 5000,
    "MaxFieldSelections": 500,
    "IntrospectionEnabled": true,
    "RejectDuplicateFields": false,
    "MaxAliasCount": 100
  },
  "InputValidation": {
    "MaxStringLength": 10000,
    "MaxCollectionSize": 1000,
    "MaxRequestSize": 209715200,
    "MaxFileSize": 52428800
  },
  "AuditLogging": {
    "LogSuccessfulOperations": true,
    "RetentionDays": 30,
    "EnableRealTimeAlerts": false,
    "AlertThresholds": {
      "FailedLoginAttempts": 50,
      "SuspiciousActivities": 20,
      "PermissionDenials": 100
    }
  },
  "Encryption": {
    "KeyRotationDays": 365
  },
  "PresentationLayer": {
    "EnableRateLimiting": true,
    "EnableCookieSecurity": true
  },
  "CookieSecurity": {
    "RequireHttps": true,
    "RequireSsl": true,
    "SameSitePolicy": "Strict",
    "SecureCookiePolicy": "Always",
    "HttpOnlyPolicy": "Always",
    "CheckConsentNeeded": false,
    "MinimumSameSitePolicy": "Strict",
    "AuthenticationCookieName": "GameGuild.Auth.Dev",
    "AuthenticationCookieExpireTimeSpan": "1.00:00:00",
    "AuthenticationCookieSlidingExpiration": true,
    "SessionCookieName": "GameGuild.Session.Dev",
    "SessionIdleTimeout": "00:30:00",
    "AntiForgeryTokenName": "GameGuild.AntiForgery.Dev"
  },
  "OpenTelemetry": {
    "Environment": "development",
    "EnableConsoleExporter": true,
    "EnableOtlpExporter": false
  },
  "HealthChecks": {
    "EnableDatabaseCheck": true,
    "EnableRedisCheck": false,
    "EnablePaymentProviderChecks": false,
    "EnableKycProviderChecks": false,
    "EnableMemoryCheck": true,
    "MemoryThresholdMB": 2048,
    "EnableDiskSpaceCheck": true,
    "DiskSpaceThresholdGB": 5
  }
}
