{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "GameGuild.Modules.Authentication": "Debug",
        "GameGuild.Modules.Authorization": "Debug",
        "GameGuild.Modules.Permissions": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj} {NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gameguild-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gameguild-errors-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "restrictedToMinimumLevel": "Error"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName",
      "WithProcessId",
      "WithThreadId",
      "WithModule"
    ],
    "Properties": {
      "Application": "GameGuild.API"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Security": {
      "Enabled": true,
      "RequireHttps": false,
      "EnforceStrongPasswords": true,
      "RequireEmailVerification": true,
      "LogAllAuthEvents": true,
      "UseBCryptHashing": true,
      "BCryptWorkFactor": 10
    },
    "Anomaly": {
      "Enabled": true,
      "MaxFailedAttemptsPerHour": 10,
      "MaxFailedAttemptsPerDay": 50,
      "MaxAttemptsPerIpPerHour": 100,
      "SuspiciousThreshold": 50,
      "ThrottleMinutes": 5,
      "LogTimingAnalysis": true,
      "AutoBlockSuspiciousIps": false,
      "AutoBlockThreshold": 100,
      "AutoBlockDurationHours": 1
    },
    "UserEnumerationProtection": {
      "Enabled": true,
      "MinProcessingTimeMs": 100,
      "MaxProcessingTimeMs": 500,
      "TargetProcessingTimeMs": 200,
      "LogTimingAnalysis": true,
      "CustomErrorMessage": null,
      "PerformDummyHashing": true,
      "DelayVarianceMs": 50
    }
  },
  "Jwt": {
    "SecretKey": "game-guild-super-secret-key-for-development-only-minimum-32-characters",
    "Issuer": "Game Guild",
    "Audience": "GameGuild.Users",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "SessionManagement": {
    "SessionLifetime": "8.00:00:00",
    "TrustedDeviceLifetime": "7.00:00:00",
    "MaxSessionsPerUser": 10,
    "RequireMfaForNewDevice": false,
    "RequireMfaForNewLocation": false,
    "SessionCleanupInterval": "01:00:00"
  },
  "RateLimiting": {
    "RequestsPerMinute": 200,
    "BurstSize": 50,
    "RequestsPerMinutePerUser": 120,
    "RequestsPerMinutePerIP": 400,
    "BurstSizePerIP": 80,
    "BurstSizePerUser": 30,
    "AuthRequestsPerMinute": 20,
    "GraphQLRequestsPerMinute": 60,
    "PaymentRequestsPerMinute": 10,
    "UseDistributedRateLimiting": true,
    "RedisConnectionString": "localhost:6379",
    "EndpointSpecificLimits": {
      "/api/auth/login": {
        "RequestsPerMinute": 10,
        "BurstSize": 5,
        "ApplyToUser": true,
        "ApplyToIP": true
      },
      "/api/auth/register": {
        "RequestsPerMinute": 5,
        "BurstSize": 2,
        "ApplyToUser": true,
        "ApplyToIP": true
      },
      "/api/auth/forgot-password": {
        "RequestsPerMinute": 3,
        "BurstSize": 1,
        "ApplyToUser": true,
        "ApplyToIP": true
      }
    }
  },
  "GraphQLSecurity": {
    "MaxDepth": 15,
    "MaxComplexity": 2000,
    "MaxFieldSelections": 200,
    "IntrospectionEnabled": true,
    "EnableQueryAnalysis": true,
    "EnableComplexityAnalysis": true,
    "EnableDepthAnalysis": true,
    "RejectDuplicateFields": false,
    "MaxAliasCount": 30
  },
  "InputValidation": {
    "EnableInputSanitization": true,
    "EnableSuspiciousContentDetection": true,
    "LogSuspiciousActivity": true,
    "MaxStringLength": 2000,
    "MaxCollectionSize": 200,
    "MaxRequestSize": 104857600,
    "AllowedFileExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".pdf",
      ".doc",
      ".docx",
      ".txt",
      ".csv"
    ],
    "MaxFileSize": 20971520
  },
  "AuditLogging": {
    "Enabled": true,
    "LogSuccessfulOperations": true,
    "LogFailedOperations": true,
    "RetentionDays": 90,
    "EnableRealTimeAlerts": false,
    "AlertThresholds": {
      "FailedLoginAttempts": 10,
      "SuspiciousActivities": 5,
      "PermissionDenials": 20
    }
  },
  "Encryption": {
    "DefaultKey": "development-32-character-key-here!",
    "KeyRotationDays": 180
  },
  "PresentationLayer": {
    "EnableRateLimiting": true,
    "EnableCookieSecurity": true
  },
  "CookieSecurity": {
    "RequireHttps": false,
    "RequireSsl": false,
    "SameSitePolicy": "Lax",
    "SecureCookiePolicy": "SameAsRequest",
    "HttpOnlyPolicy": "Always",
    "CheckConsentNeeded": false,
    "MinimumSameSitePolicy": "Unspecified",
    "AuthenticationCookieName": "GameGuild.Auth",
    "AuthenticationCookieExpireTimeSpan": "7.00:00:00",
    "AuthenticationCookieSlidingExpiration": true,
    "SessionCookieName": "GameGuild.Session",
    "SessionIdleTimeout": "00:20:00",
    "AntiForgeryTokenName": "GameGuild.AntiForgery"
  },
  "OpenTelemetry": {
    "Environment": "development",
    "EnableConsoleExporter": true,
    "EnableOtlpExporter": false,
    "OtlpEndpoint": "",
    "OtlpHeaders": ""
  },
  "HealthChecks": {
    "EnableDatabaseCheck": true,
    "EnableRedisCheck": true,
    "RedisConnectionString": "localhost:6379",
    "EnablePaymentProviderChecks": true,
    "EnableKycProviderChecks": false,
    "EnableMemoryCheck": true,
    "MemoryThresholdMB": 1024,
    "EnableDiskSpaceCheck": true,
    "DiskSpaceThresholdGB": 10
  }
}