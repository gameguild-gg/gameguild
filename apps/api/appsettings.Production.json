{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Security": {
      "RequireHttps": true,
      "EnforceStrongPasswords": true,
      "RequireEmailVerification": true,
      "LogAllAuthEvents": true,
      "BCryptWorkFactor": 12
    },
    "Anomaly": {
      "MaxFailedAttemptsPerHour": 3,
      "MaxFailedAttemptsPerDay": 10,
      "MaxAttemptsPerIpPerHour": 20,
      "SuspiciousThreshold": 15,
      "ThrottleMinutes": 30,
      "LogTimingAnalysis": false,
      "AutoBlockSuspiciousIps": true,
      "AutoBlockThreshold": 50,
      "AutoBlockDurationHours": 24
    },
    "UserEnumerationProtection": {
      "MinProcessingTimeMs": 300,
      "MaxProcessingTimeMs": 1000,
      "TargetProcessingTimeMs": 500,
      "LogTimingAnalysis": false,
      "DelayVarianceMs": 200
    }
  },
  "Jwt": {
    "SecretKey": "REPLACE-WITH-SECURE-256-bit-secret-key-that-is-at-least-32-characters-long!",
    "ExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "SessionManagement": {
    "SessionLifetime": "1.00:00:00",
    "TrustedDeviceLifetime": "30.00:00:00",
    "MaxSessionsPerUser": 3,
    "RequireMfaForNewDevice": true,
    "RequireMfaForNewLocation": true
  },
  "RateLimiting": {
    "RequestsPerMinute": 60,
    "BurstSize": 10,
    "RequestsPerMinutePerUser": 30,
    "RequestsPerMinutePerIP": 100,
    "BurstSizePerIP": 20,
    "BurstSizePerUser": 10,
    "AuthRequestsPerMinute": 5,
    "GraphQLRequestsPerMinute": 15,
    "PaymentRequestsPerMinute": 2,
    "UseDistributedRateLimiting": true,
    "RedisConnectionString": "REPLACE-WITH-REDIS-CONNECTION-STRING",
    "EndpointSpecificLimits": {
      "/api/auth/login": {
        "RequestsPerMinute": 3,
        "BurstSize": 1,
        "ApplyToUser": true,
        "ApplyToIP": true
      },
      "/api/auth/register": {
        "RequestsPerMinute": 2,
        "BurstSize": 1,
        "ApplyToUser": true,
        "ApplyToIP": true
      },
      "/api/auth/forgot-password": {
        "RequestsPerMinute": 1,
        "BurstSize": 1,
        "ApplyToUser": true,
        "ApplyToIP": true
      }
    }
  },
  "GraphQLSecurity": {
    "MaxDepth": 8,
    "MaxComplexity": 500,
    "MaxFieldSelections": 50,
    "IntrospectionEnabled": false,
    "RejectDuplicateFields": true,
    "MaxAliasCount": 10
  },
  "InputValidation": {
    "MaxStringLength": 500,
    "MaxCollectionSize": 50,
    "MaxRequestSize": 10485760,
    "AllowedFileExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".pdf"
    ],
    "MaxFileSize": 5242880
  },
  "AuditLogging": {
    "LogSuccessfulOperations": false,
    "RetentionDays": 365,
    "EnableRealTimeAlerts": true,
    "AlertThresholds": {
      "FailedLoginAttempts": 3,
      "SuspiciousActivities": 2,
      "PermissionDenials": 5
    }
  },
  "Encryption": {
    "DefaultKey": "REPLACE-WITH-SECURE-32-character-encryption-key!",
    "KeyRotationDays": 30
  },
  "PresentationLayer": {
    "EnableCookieSecurity": true
  },
  "CookieSecurity": {
    "RequireHttps": true,
    "RequireSsl": true,
    "SameSitePolicy": "Strict",
    "SecureCookiePolicy": "Always",
    "HttpOnlyPolicy": "Always",
    "CheckConsentNeeded": true,
    "MinimumSameSitePolicy": "Strict",
    "AuthenticationCookieName": "GameGuild.Auth",
    "AuthenticationCookieExpireTimeSpan": "7.00:00:00",
    "AuthenticationCookieSlidingExpiration": true,
    "SessionCookieName": "GameGuild.Session",
    "SessionIdleTimeout": "00:15:00",
    "AntiForgeryTokenName": "GameGuild.AntiForgery"
  },
  "OpenTelemetry": {
    "Environment": "production",
    "EnableConsoleExporter": false,
    "EnableOtlpExporter": true,
    "OtlpEndpoint": "https://api.honeycomb.io/v1/traces",
    "OtlpHeaders": "x-honeycomb-team=YOUR_API_KEY"
  },
  "HealthChecks": {
    "EnableDatabaseCheck": true,
    "EnableRedisCheck": true,
    "RedisConnectionString": "your-redis-connection-string",
    "EnablePaymentProviderChecks": true,
    "EnableKycProviderChecks": true,
    "EnableMemoryCheck": true,
    "MemoryThresholdMB": 8192,
    "EnableDiskSpaceCheck": true,
    "DiskSpaceThresholdGB": 50
  }
}