{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PresentationLayer": {
    "EnableCookieSecurity": true
  },
  "CookieSecurity": {
    "RequireHttps": true,
    "RequireSsl": true,
    "SameSitePolicy": "Strict",
    "SecureCookiePolicy": "Always",
    "HttpOnlyPolicy": "Always",
    "CheckConsentNeeded": true,
    "MinimumSameSitePolicy": "Strict",
    "AuthenticationCookieName": "GameGuild.Auth",
    "AuthenticationCookieExpireTimeSpan": "7.00:00:00",
    "AuthenticationCookieSlidingExpiration": true,
    "SessionCookieName": "GameGuild.Session",
    "SessionIdleTimeout": "00:15:00",
    "AntiForgeryTokenName": "GameGuild.AntiForgery"
  },
  "OpenTelemetry": {
    "Environment": "production",
    "EnableConsoleExporter": false,
    "EnableOtlpExporter": true,
    "OtlpEndpoint": "https://api.honeycomb.io/v1/traces",
    "OtlpHeaders": "x-honeycomb-team=YOUR_API_KEY"
  },
  "HealthChecks": {
    "EnableDatabaseCheck": true,
    "EnableRedisCheck": true,
    "RedisConnectionString": "your-redis-connection-string",
    "EnablePaymentProviderChecks": true,
    "EnableKycProviderChecks": true,
    "EnableMemoryCheck": true,
    "MemoryThresholdMB": 8192,
    "EnableDiskSpaceCheck": true,
    "DiskSpaceThresholdGB": 50
  }
}
