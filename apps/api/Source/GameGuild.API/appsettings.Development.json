{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AuthenticationDb": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=postgres;Include Error Detail=true",
    "DefaultConnection": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "AllowedHosts": "*",
  "PresentationLayer": {
    "EnableRateLimiting": true
