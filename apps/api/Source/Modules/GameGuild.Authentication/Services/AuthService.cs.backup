    /// </summary>
    public async Task<EmailOperationResponse> VerifyEmailAsync(
        EmailVerificationRequest verificationRequest,
        CancellationToken cancellationToken = default)
    {
        logger.LogInformation("Verifying email with token");

        try
        {
            // TODO: Extract userId from token or lookup
            var userId = Guid.NewGuid(); // TODO: Parse from token

            var isValid = await emailVerificationService.VerifyEmailTokenAsync(userId, verificationRequest.Token);

            if (!isValid)
            {
                return new EmailOperationResponse
                {
                    Success = false,
                    Message = "Invalid or expired verification token"
                };
            }

            // TODO: Mark user email as verified
            logger.LogInformation("Email verified successfully for user: {UserId}", userId);

