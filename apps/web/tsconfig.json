{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@game-guild/dotnet-wasm": [
        "../../packages/infrastructure/wasm/dotnet/src/index.ts"
      ],
      "@game-guild/assets/*": [
        "../../packages/assets/src/*"
      ],
      "@game-guild/lexical-surface/*": [
        "../../packages/features/lexical-surface/src/*"
      ],
      "@game-guild/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@game-guild/client": [
        "../../packages/infrastructure/client/src/index"
      ],
      "@game-guild/client/react": [
        "../../packages/infrastructure/client/src/integrations/react/index"
      ],
      "@game-guild/client/next": [
        "../../packages/infrastructure/client/src/integrations/next/index"
      ],
      "next": [
        "./node_modules/next"
      ],
      "next/*": [
        "./node_modules/next/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-e2e-coding-cycle/types/**/*.ts",
    ".next-e2e-coding-cycle/dev/types/**/*.ts",
    ".next-fast/types/**/*.ts",
    ".next-fast/dev/types/**/*.ts",
    ".next-e2e-grading-turbo/types/**/*.ts",
    ".next-e2e-grading-turbo/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-e2e-*",
    "vitest.config.ts",
    "src/test",
    "src/**/__tests__",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ]
}
