# apps/web/.env.local.example
#
# When using docker-compose (repo root `pnpm dev`), the root .env is injected
# into the web container and this file is NOT needed.
#
# When running `pnpm --filter @game-guild/web run dev` directly (no
# docker-compose), Next.js loads env from this directory (`apps/web/`), NOT
# the repo root. Copy this file to `.env.local` and fill in real values:
#
#   cp apps/web/.env.local.example apps/web/.env.local
#
# .env.local is gitignored by default — never commit secrets.

# --- Auth ---
# Session encryption secret (min 32 chars). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-secret-at-least-32-characters

# --- Backend API ---
# The .NET API base URL. Default matches `dotnet run` default port.
API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Cookie domain (optional; for cross-subdomain auth in local dev) ---
# Set to ".gameguild.localhost" if running across multiple subdomains.
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_SECURE=false

# --- Public URLs (optional; used for absolute links + sitemap) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LEARNING_APP_URL=http://localhost:3002