# Auth secret for session encryption (min 32 chars)
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Backend API URL (the .NET API)
API_URL=http://localhost:8080

# This app's public URL (used for callbacks)
NEXTAUTH_URL=http://localhost:3002

# Public web app URL for links back to the course catalog
NEXT_PUBLIC_WEB_URL=http://localhost:3000
