Table "economy_funding_claims" {
  "SourceStampId" uuid [not null]
  "WalletId" uuid [not null]
  "Provider" "character varying(100)" [not null]
  "Environment" "character varying(50)" [not null]
  "ConnectedAccount" "character varying(256)" [not null]
  "ProviderObject" "character varying(256)" [not null]
  "ProviderMonetaryLeg" "character varying(256)" [not null]
  "AuthoritativeUsdMinorUnits" bigint [not null]
  "State" integer [not null]
  "ObservedAt" timestamp [not null]
  "ConfirmedAt" timestamp
  "StateChangedAt" timestamp [not null]
  "PostingGroupId" uuid
  "RootCreditLotId" uuid
  "CumulativeProviderReversalUnits" bigint [not null]
  "Version" bigint [not null]

  Checks {
    `"AuthoritativeUsdMinorUnits" > 0` [name: 'ck_economy_funding_claims_amount_positive']
    `("State" = 1 AND "ConfirmedAt" IS NULL AND "StateChangedAt" = "ObservedAt" AND "PostingGroupId" IS NULL AND "RootCreditLotId" IS NULL AND "CumulativeProviderReversalUnits" = 0) OR ("State" = 2 AND "ConfirmedAt" >= "ObservedAt" AND "StateChangedAt" >= "ConfirmedAt" AND "PostingGroupId" IS NOT NULL AND "RootCreditLotId" IS NOT NULL) OR ("State" IN (3, 4) AND "ConfirmedAt" IS NULL AND "StateChangedAt" >= "ObservedAt" AND "PostingGroupId" IS NULL AND "RootCreditLotId" IS NULL AND "CumulativeProviderReversalUnits" = 0) OR ("State" IN (5, 6) AND "ConfirmedAt" >= "ObservedAt" AND "StateChangedAt" >= "ConfirmedAt" AND "PostingGroupId" IS NOT NULL AND "RootCreditLotId" IS NOT NULL AND "CumulativeProviderReversalUnits" > 0)` [name: 'ck_economy_funding_claims_lifecycle']
    `"CumulativeProviderReversalUnits" >= 0 AND "CumulativeProviderReversalUnits" <= "AuthoritativeUsdMinorUnits"` [name: 'ck_economy_funding_claims_provider_reversal_bounds']
    `"Version" > 0` [name: 'ck_economy_funding_claims_version_positive']
  }

  Indexes {
    SourceStampId [pk, name: "PK_economy_funding_claims"]
    WalletId [name: "IX_economy_funding_claims_WalletId"]
    PostingGroupId [unique, name: "ux_economy_funding_claims_posting_group"]
    (Provider, Environment, ConnectedAccount, ProviderObject, ProviderMonetaryLeg) [unique, name: "ux_economy_funding_claims_provider_leg"]
    RootCreditLotId [unique, name: "ux_economy_funding_claims_root_lot"]
  }
}

