  Checks {
    `"Status" <> 3 OR ("RiskDecisionId" IS NOT NULL AND "ProceedsSourceStampId" IS NOT NULL AND "ProceedsLotId" IS NOT NULL)` [name: 'ck_economy_bounty_terminal_events_claim_binding']
    `"Status" IN (3, 4)` [name: 'ck_economy_bounty_terminal_events_state']
    `"ReturnedUnits" >= 0 AND "FeeUnits" >= 0 AND "FirstJournalSequence" > 0` [name: 'ck_economy_bounty_terminal_events_units']
  }

  Indexes {
    Id [pk, name: "PK_economy_bounty_terminal_events"]
    BountyId [unique, name: "IX_economy_bounty_terminal_events_BountyId"]
    IdempotencyKey [unique, name: "IX_economy_bounty_terminal_events_IdempotencyKey"]
