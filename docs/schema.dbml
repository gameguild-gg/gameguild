  "Id" uuid [not null]
  "SettlementId" uuid [not null]
  "Purpose" integer [not null]
  "WalletId" uuid [not null]
  "CreditLotId" uuid [not null]
  "SourceStampId" uuid
  "Currency" integer [not null]
  "AmountUnits" bigint [not null]
  "RefundHoldId" uuid [not null]
  "RefundHoldUntil" timestamp [not null]
  "ParentLineage" jsonb [not null]

  Checks {
    `"AmountUnits" > 0` [name: 'ck_economy_marketplace_settlement_credits_amount']
    `"Purpose" BETWEEN 1 AND 2` [name: 'ck_economy_marketplace_settlement_credits_purpose']
  }

  Indexes {
    Id [pk, name: "PK_economy_marketplace_settlement_credits"]
    CreditLotId [unique, name: "IX_economy_marketplace_settlement_credits_CreditLotId"]
    SettlementId [name: "IX_economy_marketplace_settlement_credits_SettlementId"]
    SourceStampId [unique, name: "IX_economy_marketplace_settlement_credits_SourceStampId"]
  }
}

Table "economy_marketplace_settlement_legs" {
  "SettlementId" uuid [not null]
  "Currency" integer [not null]
  "Units" bigint [not null]
  "SellerUnits" bigint [not null]
  "PlatformFeeUnits" bigint [not null]
  "RefundedUnits" bigint [not null]

  Checks {
    `"Units" > 0 AND "SellerUnits" >= 0 AND "PlatformFeeUnits" >= 0 AND "SellerUnits" + "PlatformFeeUnits" = "Units"` [name: 'ck_economy_marketplace_settlement_legs_conservation']
    `"RefundedUnits" BETWEEN 0 AND "Units"` [name: 'ck_economy_marketplace_settlement_legs_refund']
  }

  Indexes {
    (SettlementId, Currency) [pk, name: "PK_economy_marketplace_settlement_legs"]
  }
}

Table "economy_payout_provider_events" {
  "EventId" "character varying(256)" [not null]
  "EventHash" "character varying(128)" [not null]
  "OperationId" uuid [not null]
  "ResultingState" integer [not null]
  "RecordedAt" timestamp [not null]

  Indexes {
    EventId [pk, name: "PK_economy_payout_provider_events"]
    (OperationId, RecordedAt) [name: "ix_economy_payout_provider_events_operation_recorded"]
  }
}

Table "economy_reserve_asset_allocations" {
  "Id" uuid [not null]
  "ReserveVersion" bigint [not null]
  "AssetKey" "character varying(256)" [not null]
  "Purpose" integer [not null]
  "EligibleUsdNanos" bigint [not null]

  Checks {
    `"EligibleUsdNanos" > 0` [name: 'ck_economy_reserve_asset_allocations_value_positive']
    `"Purpose" IN (1, 2) AND length(btrim("AssetKey")) > 0` [name: 'ck_economy_reserve_asset_allocations_values_valid']
  }

  Indexes {
    Id [pk, name: "PK_economy_reserve_asset_allocations"]
    (ReserveVersion, AssetKey) [unique, name: "ux_economy_reserve_asset_allocations_version_asset"]
  }
}

Table "economy_posting_groups" {
  "Id" uuid [not null]
  "IdempotencyKey" "character varying(128)" [not null]
  "TemplateKind" integer [not null]
  "TemplateVersion" integer [not null]
  "Authority" integer [not null]
  "Status" integer [not null]
  "CapabilityId" uuid [not null]
  "ActorId" uuid [not null]
  "TenantId" uuid [not null]
  "RiskDecisionId" uuid
  "PolicyVersion" bigint [not null]
  "ReserveVersion" bigint [not null]
  "ReserveAuthorizationEpoch" bigint [not null]
  "SourceStampId" uuid
  "RecordedAt" timestamp [not null]

  Checks {
    `("TemplateKind" IN (1, 2, 3, 18, 19, 20) AND "Authority" = 1) OR ("TemplateKind" IN (4, 5, 7, 8, 17) AND "Authority" = 2) OR ("TemplateKind" IN (6, 21) AND "Authority" = 3) OR ("TemplateKind" IN (9, 10) AND "Authority" = 4) OR ("TemplateKind" IN (11, 12, 13) AND "Authority" = 5) OR ("TemplateKind" IN (14, 15, 16) AND "Authority" = 6)` [name: 'ck_economy_posting_groups_authority_template']
    `"ReserveVersion" > 0 AND "ReserveAuthorizationEpoch" > 0 AND "RiskDecisionId" IS NOT NULL` [name: 'ck_economy_posting_groups_reserve_authorization']
    `"TemplateKind" NOT IN (1, 2, 3, 18, 19, 20) OR "SourceStampId" IS NOT NULL` [name: 'ck_economy_posting_groups_source_requirement']
    `"TemplateKind" BETWEEN 1 AND 21 AND "TemplateVersion" = 1 AND "Status" = 1` [name: 'ck_economy_posting_groups_template_state']
  }

  Indexes {
    Id [pk, name: "PK_economy_posting_groups"]
    IdempotencyKey [unique, name: "ux_economy_posting_groups_idempotency_key"]
    SourceStampId [unique, name: "ux_economy_posting_groups_source_stamp"]
  }
}

Table "economy_root_reversal_states" {
  "RootSourceStampId" uuid [not null]
  "Epoch" bigint [not null]
  "CumulativeProviderUnits" bigint [not null]
  "ReversedUnits" bigint [not null]
  "State" "character varying(50)" [not null]
  "TargetedRanges" jsonb [not null]
  "UpdatedAt" timestamp [not null]

  Checks {
    `"CumulativeProviderUnits" >= 0 AND "ReversedUnits" >= 0 AND "ReversedUnits" <= "CumulativeProviderUnits"` [name: 'ck_economy_root_reversal_states_cumulative_bounds']
    `"Epoch" >= 0` [name: 'ck_economy_root_reversal_states_epoch_nonnegative']
  }

  Indexes {
    RootSourceStampId [pk, name: "PK_economy_root_reversal_states"]
    (RootSourceStampId, Epoch) [unique, name: "ux_economy_root_reversal_states_root_epoch"]
  }
}

Table "economy_source_stamp_events" {
  "Id" uuid [not null]
  "SourceStampId" uuid [not null]
  "Sequence" bigint [not null]
  "State" integer [not null]
  "EvidenceHash" "character varying(128)" [not null]
  "OccurredAt" timestamp [not null]

  Checks {
    `"Sequence" > 0` [name: 'ck_economy_source_stamp_events_sequence_positive']
  }

  Indexes {
    Id [pk, name: "PK_economy_source_stamp_events"]
    (SourceStampId, Sequence) [unique, name: "ux_economy_source_stamp_events_source_sequence"]
  }
}

Table "economy_accounts" {
  "Id" uuid [not null]
  "WalletId" uuid
  "Code" integer [not null]
  "Currency" integer [not null]
  "Provenance" integer
  "CreatedAt" timestamp [not null]

  Checks {
    `("WalletId" IS NULL AND "Code" NOT IN (2, 3, 4)) OR ("WalletId" IS NOT NULL AND "Code" IN (2, 3, 4))` [name: 'ck_economy_accounts_wallet_partition']
  }

  Indexes {
    Id [pk, name: "PK_economy_accounts"]
    (WalletId, Code, Currency, Provenance) [unique, name: "IX_economy_accounts_WalletId_Code_Currency_Provenance"]
  }
}

Table "economy_credit_lots" {
  "Id" uuid [not null]
  "WalletId" uuid [not null]
  "RootSourceStampId" uuid [not null]
  "Currency" integer [not null]
  "AmountUnits" bigint [not null]
  "Provenance" integer [not null]
  "CreditedAt" timestamp [not null]
  "ConfirmedAt" timestamp [not null]
  "OriginalMaturesAt" timestamp [not null]
  "CashOutEligible" boolean [not null]
  "JournalSequence" bigint [not null]
  "State" integer [not null]
  "ReversalEpoch" bigint [not null]

  Checks {
    `"AmountUnits" > 0` [name: 'ck_economy_credit_lots_amount_positive']
    `"OriginalMaturesAt" >= "ConfirmedAt"` [name: 'ck_economy_credit_lots_maturity_order']
    `("Provenance" = 2 AND "Currency" = 1 AND "CashOutEligible" AND "OriginalMaturesAt" = "ConfirmedAt" + INTERVAL '120 days') OR ("Provenance" <> 2 AND NOT "CashOutEligible")` [name: 'ck_economy_credit_lots_maturity_policy']
  }

  Indexes {
    Id [pk, name: "PK_economy_credit_lots"]
    RootSourceStampId [name: "ix_economy_credit_lots_root_source"]
    WalletId [name: "IX_economy_credit_lots_WalletId"]
  }
}

Table "economy_holds" {
  "Id" uuid [not null]
  "WalletId" uuid [not null]
  "Currency" integer [not null]
  "AmountUnits" bigint [not null]
  "Reason" integer [not null]
  "Status" integer [not null]
  "EffectiveAt" timestamp [not null]
  "ReleasedAt" timestamp

  Checks {
    `"AmountUnits" > 0` [name: 'ck_economy_holds_amount_positive']
    `("Status" = 1 AND "ReleasedAt" IS NULL) OR ("Status" <> 1 AND "ReleasedAt" >= "EffectiveAt")` [name: 'ck_economy_holds_state_timestamp']
  }

  Indexes {
    Id [pk, name: "PK_economy_holds"]
    (WalletId, Status) [name: "ix_economy_holds_wallet_status"]
  }
}

Table "economy_projection_reconciliation_events" {
  "Id" uuid [not null]
  "WalletId" uuid [not null]
  "PreviousHash" "character varying(128)" [not null]
  "RebuiltHash" "character varying(128)" [not null]
  "SourceJournalSequence" bigint [not null]
  "DetectedAt" timestamp [not null]

  Checks {
    `"SourceJournalSequence" >= 0` [name: 'ck_economy_projection_events_sequence_nonnegative']
  }

  Indexes {
    Id [pk, name: "PK_economy_projection_reconciliation_events"]
    (WalletId, DetectedAt) [name: "ix_economy_projection_reconciliation_events_wallet_detected"]
  }
}

Table "economy_provider_disputes" {
  "ProviderDisputeReference" "character varying(256)" [not null]
  "SourceStampId" uuid [not null]
  "ResponsibleWalletId" uuid [not null]
  "Status" integer [not null]
  "LatestProviderSequence" bigint [not null]
  "CumulativeDisputedHardUnits" bigint [not null]
  "BaselineReversedHardUnits" bigint [not null]
  "FrozenHardEquivalentUnits" bigint [not null]
  "ReversalIdempotencyKey" "character varying(128)"
  "UpdatedAt" timestamp [not null]
  "Version" bigint [not null]

  Checks {
    `"CumulativeDisputedHardUnits" > 0 AND "BaselineReversedHardUnits" >= 0 AND "BaselineReversedHardUnits" <= "CumulativeDisputedHardUnits" AND "FrozenHardEquivalentUnits" >= 0 AND "FrozenHardEquivalentUnits" <= ("CumulativeDisputedHardUnits" - "BaselineReversedHardUnits")` [name: 'ck_economy_provider_disputes_amount_partition']
    `("Status" = 1 AND "ReversalIdempotencyKey" IS NULL) OR ("Status" = 2 AND "FrozenHardEquivalentUnits" = 0 AND "ReversalIdempotencyKey" IS NULL) OR ("Status" = 3 AND "FrozenHardEquivalentUnits" = 0 AND "ReversalIdempotencyKey" IS NOT NULL)` [name: 'ck_economy_provider_disputes_lifecycle']
    `"LatestProviderSequence" > 0` [name: 'ck_economy_provider_disputes_sequence_positive']
    `"Version" > 0` [name: 'ck_economy_provider_disputes_version_positive']
  }

  Indexes {
    ProviderDisputeReference [pk, name: "PK_economy_provider_disputes"]
    ResponsibleWalletId [name: "IX_economy_provider_disputes_ResponsibleWalletId"]
    SourceStampId [unique, name: "ux_economy_provider_disputes_active_source"]
  }
}

Table "economy_risk_decisions" {
  "Id" uuid [not null]
  "Outcome" integer [not null]
  "OperationFingerprint" "character varying(128)" [not null]
  "IdempotencyKey" "character varying(128)"
  "ActorHash" "character varying(128)" [not null]
  "TemplateKind" integer [not null]
  "SourceWalletId" uuid [not null]
  "DestinationWalletId" uuid [not null]
  "Currency" integer [not null]
  "AmountUnits" bigint [not null]
  "CurrencyLegs" jsonb [not null]
  "SourceRoots" jsonb [not null]
  "ProviderReferenceHash" "character varying(128)" [not null]
  "PolicyVersion" bigint [not null]
  "ReserveVersion" bigint [not null]
  "ReserveAuthorizationEpoch" bigint [not null]
  "FeatureVersion" bigint [not null]
  "KillSwitchEpoch" bigint [not null]
  "CounterVersion" bigint [not null]
  "EntityGraphVersion" bigint [not null]
  "EntityGraphEvidenceHash" "character varying(128)" [not null]
  "ReasonCodes" jsonb [not null]
  "IssuedAt" timestamp [not null]
  "ExpiresAt" timestamp [not null]

  Checks {
    `"AmountUnits" > 0` [name: 'ck_economy_risk_decisions_amount_positive']
    `"ExpiresAt" > "IssuedAt"` [name: 'ck_economy_risk_decisions_lifetime']
    `"PolicyVersion" > 0 AND "ReserveVersion" > 0 AND "ReserveAuthorizationEpoch" > 0 AND "FeatureVersion" > 0 AND "CounterVersion" > 0 AND "EntityGraphVersion" >= 0` [name: 'ck_economy_risk_decisions_versions_positive']
  }

  Indexes {
    Id [pk, name: "PK_economy_risk_decisions"]
    DestinationWalletId [name: "IX_economy_risk_decisions_DestinationWalletId"]
    OperationFingerprint [unique, name: "ix_economy_risk_decisions_operation_fingerprint"]
    SourceWalletId [name: "IX_economy_risk_decisions_SourceWalletId"]
  }
}

Table "economy_wallet_balance_projections" {
  "WalletId" uuid [not null]
  "PendingHard" bigint [not null]
  "PendingSoft" bigint [not null]
  "PurchasedHard" bigint [not null]
  "EarnedHard" bigint [not null]
  "RestrictedHard" bigint [not null]
  "Soft" bigint [not null]
  "ImmatureEarnedHard" bigint [not null]
  "HeldHard" bigint [not null]
  "HeldSoft" bigint [not null]
  "AvailableHardToSpend" bigint [not null]
  "AvailableSoftToSpend" bigint [not null]
  "WithdrawableHard" bigint [not null]
