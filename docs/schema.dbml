Table "economy_ad_reward_reconciliations" {
  "Id" uuid [not null]
  "ProviderReportId" uuid [not null]
  "Network" "character varying(100)" [not null]
  "ReportId" "character varying(256)" [not null]
  "Version" integer [not null]
  "BatchId" "character varying(256)" [not null]
  "EstimatedRevenueUsdNanos" bigint [not null]
  "PreviousActualRevenueUsdNanos" bigint [not null]
  "ActualRevenueUsdNanos" bigint [not null]
  "ActualDeltaUsdNanos" bigint [not null]
  "VarianceUsdNanos" bigint [not null]
  "HistoricalRewardSoftUnits" bigint [not null]
  "ReconciledAt" timestamp [not null]

  Checks {
    `"ActualDeltaUsdNanos" = "ActualRevenueUsdNanos" - "PreviousActualRevenueUsdNanos" AND "VarianceUsdNanos" = "ActualRevenueUsdNanos" - "EstimatedRevenueUsdNanos"` [name: 'ck_economy_ad_reward_reconciliations_conservation']
    `"EstimatedRevenueUsdNanos" >= 0 AND "PreviousActualRevenueUsdNanos" >= 0 AND "ActualRevenueUsdNanos" >= 0 AND "HistoricalRewardSoftUnits" >= 0` [name: 'ck_economy_ad_reward_reconciliations_nonnegative']
    `"Version" > 0` [name: 'ck_economy_ad_reward_reconciliations_version']
  }

  Indexes {
    Id [pk, name: "PK_economy_ad_reward_reconciliations"]
    (Network, ReportId, Version) [unique, name: "IX_economy_ad_reward_reconciliations_Network_ReportId_Version"]
    ProviderReportId [unique, name: "IX_economy_ad_reward_reconciliations_ProviderReportId"]
  }
}

