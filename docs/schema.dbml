Table "economy_fragment_root_ranges" {
  "Id" uuid [not null]
  "RootSourceStampId" uuid [not null]
  "CreditLotId" uuid
  "EntryAllocationId" uuid
  "StartInclusive" bigint [not null]
  "EndExclusive" bigint [not null]
  "ReversalEpoch" bigint [not null]

  Checks {
    `"StartInclusive" >= 0 AND "EndExclusive" > "StartInclusive"` [name: 'ck_economy_fragment_root_ranges_half_open']
    `("CreditLotId" IS NULL) <> ("EntryAllocationId" IS NULL)` [name: 'ck_economy_fragment_root_ranges_single_owner']
  }

  Indexes {
