  "SelectedRootRanges" jsonb [not null]

  Checks {
    `"AmountUnits" > 0` [name: 'ck_economy_bounty_escrow_fragments_amount_positive']
    `"Provenance" BETWEEN 1 AND 7` [name: 'ck_economy_bounty_escrow_fragments_provenance']
    `"TraceUnitsPerCoinUnit" > 0` [name: 'ck_economy_bounty_escrow_fragments_scale_positive']
  }

  Indexes {
