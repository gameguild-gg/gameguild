  Checks {
    `"PendingHard" >= 0 AND "PendingSoft" >= 0 AND "PurchasedHard" >= 0 AND "EarnedHard" >= 0 AND "RestrictedHard" >= 0 AND "Soft" >= 0 AND "ImmatureEarnedHard" >= 0 AND "HeldHard" >= 0 AND "HeldSoft" >= 0 AND "AvailableHardToSpend" >= 0 AND "AvailableSoftToSpend" >= 0 AND "WithdrawableHard" >= 0` [name: 'ck_economy_wallet_balance_projections_amounts_nonnegative']
    `"SourceJournalSequence" >= 0` [name: 'ck_economy_wallet_balance_projections_sequence_nonnegative']
  }

  Indexes {
    WalletId [pk, name: "PK_economy_wallet_balance_projections"]
    ReviewState [name: "ix_economy_wallet_balance_projections_review_state"]
  }
}

