Table "payments" {
  "Id" uuid [not null]
  "TenantId" uuid [not null]
  "SubscriptionId" uuid
  "OrderId" uuid
  "InvoiceId" uuid
  "Amount" numeric(18,2) [not null]
  "Currency" "character varying(3)" [not null]
  "Status" integer [not null]
  "Provider" "character varying(50)" [not null]
  "ExternalPaymentId" "character varying(255)"
  "ExternalTransactionId" "character varying(255)"
  "ExternalCustomerId" "character varying(255)"
  "ProviderEnvironment" "character varying(32)"
  "ProviderAccountId" "character varying(255)"
  "ProviderObjectId" "character varying(255)"
  "ProviderObjectType" "character varying(100)"
  "ProviderMonetaryLeg" "character varying(100)"
  "PaymentMethodId" "character varying(255)"
  "IdempotencyKey" "character varying(255)" [not null]
  "Description" "character varying(500)"
  "FailureReason" "character varying(1000)"
  "ErrorCode" "character varying(100)"
  "ProcessedAt" timestamp
  "CancelledAt" timestamp
  "CancellationReason" "character varying(500)"
  "CancelledByUserId" uuid
  "RetryCount" integer [not null]
  "MaxRetries" integer [not null]
  "NextRetryAt" timestamp
  "RefundedAmount" numeric(18,2) [not null]
  "RefundId" "character varying(255)"
  "RefundReason" "character varying(500)"
  "RefundedAt" timestamp
  "Metadata" jsonb
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp

  Checks {
    `"ProviderEnvironment" IS NULL OR "ProviderEnvironment" IN ('test', 'live')` [name: 'ck_payments_provider_environment']
    `(("ProviderEnvironment" IS NULL AND "ProviderAccountId" IS NULL AND "ProviderObjectId" IS NULL AND "ProviderObjectType" IS NULL AND "ProviderMonetaryLeg" IS NULL) OR ("ProviderEnvironment" IS NOT NULL AND "ProviderAccountId" IS NOT NULL AND "ProviderObjectId" IS NOT NULL AND "ProviderObjectType" IS NOT NULL AND "ProviderMonetaryLeg" IS NOT NULL))` [name: 'ck_payments_provider_mapping_complete']
    `(lower("Provider") <> 'stripe' OR "Status" NOT IN (1, 2, 5, 6, 7) OR ("ProviderEnvironment" IS NOT NULL AND "ProviderAccountId" IS NOT NULL AND "ProviderObjectId" IS NOT NULL AND "ProviderObjectType" IS NOT NULL AND "ProviderMonetaryLeg" IS NOT NULL))` [name: 'ck_payments_stripe_value_mapping_required']
  }

  Indexes {
    Id [pk, name: "PK_payments"]
    ExternalPaymentId [unique, name: "IX_payments_ExternalPaymentId"]
    IdempotencyKey [unique, name: "IX_payments_IdempotencyKey"]
    (Provider, ProviderEnvironment, ProviderAccountId, ProviderObjectId, ProviderMonetaryLeg) [unique, name: "ix_payments_provider_object_leg"]
    SubscriptionId [name: "IX_payments_SubscriptionId"]
    (TenantId, Status) [name: "IX_payments_TenantId_Status"]
  }
}

