Table "economy_marketplace_currency_policy_versions" {
  "ProductId" uuid [not null]
  "Version" bigint [not null]
  "SellerId" uuid [not null]
  "Mode" integer [not null]
  "HardPriceUnits" bigint [not null]
  "SoftPriceUnits" bigint [not null]
  "PlatformFeePpm" integer [not null]
  "EffectiveAt" timestamp [not null]

  Checks {
    `"PlatformFeePpm" BETWEEN 0 AND 999999` [name: 'ck_economy_marketplace_currency_policy_versions_fee']
    `("Mode" = 1 AND "HardPriceUnits" > 0 AND "SoftPriceUnits" = 0) OR ("Mode" = 2 AND "HardPriceUnits" = 0 AND "SoftPriceUnits" > 0) OR ("Mode" IN (3, 4) AND "HardPriceUnits" > 0 AND "SoftPriceUnits" > 0)` [name: 'ck_economy_marketplace_currency_policy_versions_prices']
    `"Version" > 0` [name: 'ck_economy_marketplace_currency_policy_versions_version']
  }

  Indexes {
    (ProductId, Version) [pk, name: "PK_economy_marketplace_currency_policy_versions"]
    (ProductId, EffectiveAt) [name: "IX_economy_marketplace_currency_policy_versions_ProductId_Effe~"]
  }
}

Table "economy_marketplace_settlements" {
  "Id" uuid [not null]
  "OrderId" uuid [not null]
  "ProductId" uuid [not null]
  "BuyerId" uuid [not null]
  "BuyerWalletId" uuid [not null]
  "SellerId" uuid [not null]
  "SellerWalletId" uuid [not null]
  "PlatformFeeWalletId" uuid [not null]
  "PolicyVersion" bigint [not null]
  "CurrencyMode" integer [not null]
  "Status" integer [not null]
  "IdempotencyKey" "character varying(256)" [not null]
  "EntitlementId" uuid [not null]
  "RefundHoldUntil" timestamp [not null]
  "SettledAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "Version" bigint [not null]

  Checks {
    `"RefundHoldUntil" > "SettledAt"` [name: 'ck_economy_marketplace_settlements_hold']
    `"Status" BETWEEN 1 AND 3` [name: 'ck_economy_marketplace_settlements_state']
    `"PolicyVersion" > 0 AND "Version" > 0` [name: 'ck_economy_marketplace_settlements_version']
    `"BuyerWalletId" <> "SellerWalletId" AND "BuyerWalletId" <> "PlatformFeeWalletId" AND "SellerWalletId" <> "PlatformFeeWalletId"` [name: 'ck_economy_marketplace_settlements_wallets']
  }

  Indexes {
    Id [pk, name: "PK_economy_marketplace_settlements"]
    (BuyerId, SettledAt) [name: "IX_economy_marketplace_settlements_BuyerId_SettledAt"]
    IdempotencyKey [unique, name: "IX_economy_marketplace_settlements_IdempotencyKey"]
    OrderId [unique, name: "IX_economy_marketplace_settlements_OrderId"]
    (SellerId, SettledAt) [name: "IX_economy_marketplace_settlements_SellerId_SettledAt"]
  }
}

Table "economy_payout_operations" {
  "Id" uuid [not null]
  "IdempotencyKey" "character varying(256)" [not null]
  "RequestHash" "character varying(128)" [not null]
  "ActorId" uuid [not null]
  "PayeeId" uuid [not null]
  "WalletId" uuid [not null]
  "AmountUnits" bigint [not null]
  "ProviderAccountId" "character varying(256)" [not null]
  "DestinationHash" "character varying(128)" [not null]
  "ProviderBindingHash" "character varying(128)" [not null]
  "EligibilityHash" "character varying(128)" [not null]
  "DispatchSnapshotHash" "character varying(128)"
  "ProviderPayoutId" "character varying(256)"
  "State" integer [not null]
  "Version" bigint [not null]
  "FencingToken" bigint [not null]
  "KillSwitchEpoch" bigint [not null]
  "ReserveVersion" bigint [not null]
  "ReserveAuthorizationEpoch" bigint [not null]
  "PolicyVersion" bigint [not null]
  "RiskDecisionId" uuid [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]

  Checks {
    `("State" = 1 AND "DispatchSnapshotHash" IS NULL) OR ("State" BETWEEN 2 AND 6 AND "DispatchSnapshotHash" IS NOT NULL)` [name: 'ck_economy_payout_operations_dispatch']
    `"AmountUnits" > 0 AND "Version" > 0 AND "FencingToken" > 0 AND "KillSwitchEpoch" > 0 AND "ReserveVersion" > 0 AND "ReserveAuthorizationEpoch" > 0 AND "PolicyVersion" > 0` [name: 'ck_economy_payout_operations_positive_values']
    `"State" BETWEEN 1 AND 6` [name: 'ck_economy_payout_operations_state']
    `"UpdatedAt" >= "CreatedAt"` [name: 'ck_economy_payout_operations_timestamps']
  }

  Indexes {
    Id [pk, name: "PK_economy_payout_operations"]
    (State, UpdatedAt) [name: "ix_economy_payout_operations_state_updated"]
    IdempotencyKey [unique, name: "ux_economy_payout_operations_idempotency"]
  }
}

Table "economy_protected_change_cooldowns" {
