Table "resources"."resource_quotas" {
  "Id" uuid [not null, note: 'Unique identifier for the resource quota']
  "Type" integer [not null, note: 'Type of resource being limited']
  "UserId" uuid
  "SoftLimit" bigint [note: 'Soft limit (warning threshold)']
  "HardLimit" bigint [note: 'Hard limit (enforcement threshold)']
  "CurrentUsage" bigint [not null, default: 0, note: 'Current usage amount']
  "IsActive" boolean [not null, default: true, note: 'Whether this quota is actively enforced']
  "Period" integer [not null, note: 'Period type for quota reset']
  "LastReset" timestamp
  "ResetTime" interval
  "ResetDayOfWeek" integer
  "ResetDayOfMonth" integer
  "NotificationsEnabled" boolean [not null]
  "NotificationThresholds" "character varying(100)"
  "Description" "character varying(500)"
  "Metadata" varchar(2000) [note: 'Additional metadata stored as JSON']
  "RowVersion" bytea [note: 'Optimistic concurrency token for quota updates']
  "Version" integer [not null]
  "CreatedAt" timestamp [not null, default: `CURRENT_TIMESTAMP`, note: 'When the quota was created']
  "UpdatedAt" timestamp [not null, default: `CURRENT_TIMESTAMP`, note: 'When the quota was last updated']
  "DeletedAt" timestamp
  "TenantId" uuid [not null, note: 'Tenant that owns this quota']

  Checks {
    `"HardLimit" IS NULL OR "CurrentUsage" <= "HardLimit"` [name: 'CK_ResourceQuota_CurrentUsage_LessEqual_MaxUsage']
    `"CurrentUsage" >= 0` [name: 'CK_ResourceQuota_CurrentUsage_NonNegative']
    `"HardLimit" IS NULL OR "HardLimit" >= 0` [name: 'CK_ResourceQuota_MaxUsage_NonNegative']
  }

  Indexes {
    Id [pk, name: "PK_resource_quotas"]
    Type [name: "IX_ResourceQuotas_ResourceType"]
    (TenantId, Type) [unique, name: "IX_ResourceQuotas_TenantId_ResourceType"]
  }
}

Table "resources"."usage_records" {
  "Id" uuid [not null, note: 'Unique identifier for the usage record']
  "Type" integer [not null, note: 'Type of resource used']
  "Count" bigint [not null, note: 'Amount of resource consumed']
  "UsageAmount" bigint [not null]
  "PeriodStart" timestamp [not null, note: 'When the usage period started']
  "PeriodEnd" timestamp [not null, note: 'When the usage period ended']
  "AveragePerDay" doubleprecision [note: 'Average usage per day']
  "PeakUsage" bigint [note: 'Peak usage during period']
  "PeakUsageDate" timestamp [note: 'When peak usage occurred']
  "Metadata" jsonb [note: 'Additional metadata in JSON format']
  "Source" "character varying(50)"
  "UserId" uuid
  "ResourceId" uuid
  "ResourceQuotaId" uuid [not null, note: 'Associated resource quota']
  "Version" integer [not null]
  "CreatedAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "UpdatedAt" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "DeletedAt" timestamp
  "TenantId" uuid [not null, note: 'Tenant that used the resource']

  Checks {
    `"Count" >= 0` [name: 'CK_UsageRecord_Count_NonNegative']
    `"PeakUsage" IS NULL OR "PeakUsage" >= 0` [name: 'CK_UsageRecord_PeakUsage_NonNegative']
    `"PeriodEnd" >= "PeriodStart"` [name: 'CK_UsageRecord_PeriodOrder']
  }

  Indexes {
    Id [pk, name: "PK_usage_records"]
    PeriodStart [name: "IX_UsageRecords_PeriodStart"]
    (TenantId, Type, PeriodStart) [name: "IX_UsageRecords_Tenant_Resource_Time"]
    (PeriodStart, PeriodEnd) [name: "IX_UsageRecords_UsagePeriod"]
  }
}

