  "RevokedAt" timestamp

  Checks {
    `("IsEnabled" AND "RevokedAt" IS NULL) OR (NOT "IsEnabled" AND "RevokedAt" IS NOT NULL)` [name: 'ck_economy_registered_capabilities_state']
  }

  Indexes {
    Id [pk, name: "PK_economy_registered_capabilities"]
    Name [unique, name: "ux_economy_registered_capabilities_name"]
  }
}

Table "economy_reserve_heads" {
  "Version" bigint [not null]
  "IsActive" boolean [not null]
  "PolicyVersion" bigint [not null]
  "AuthorizationEpoch" bigint [not null]
  "ObservedAt" timestamp [not null]
  "ExpiresAt" timestamp [not null]
  "HardFaceValueUsdMinor" bigint [not null]
  "RequiredHardReserveUsdMinor" bigint [not null]
  "SoftFaceValueUsdNanos" bigint [not null]
  "StressedExpectedRedemptionCostUsdNanos" bigint [not null]
  "RequiredSoftReserveUsdNanos" bigint [not null]
  "HardBackingUsdNanos" bigint [not null]
  "SoftBackingUsdNanos" bigint [not null]
  "Coverage" integer [not null]
  "EvidenceHash" "character varying(128)" [not null]
  "ActivatedAt" timestamp [not null]

  Checks {
    `"HardFaceValueUsdMinor" >= 0 AND "RequiredHardReserveUsdMinor" >= 0 AND "SoftFaceValueUsdNanos" >= 0 AND "StressedExpectedRedemptionCostUsdNanos" >= 0 AND "RequiredSoftReserveUsdNanos" >= 0 AND "HardBackingUsdNanos" >= 0 AND "SoftBackingUsdNanos" >= 0` [name: 'ck_economy_reserve_heads_amounts_nonnegative']
    `"Coverage" IN (1, 2) AND length(btrim("EvidenceHash")) > 0` [name: 'ck_economy_reserve_heads_values_valid']
    `"Version" > 0 AND "PolicyVersion" > 0 AND "AuthorizationEpoch" > 0` [name: 'ck_economy_reserve_heads_versions_positive']
    `"ExpiresAt" > "ObservedAt" AND "ActivatedAt" >= "ObservedAt"` [name: 'ck_economy_reserve_heads_window']
  }

  Indexes {
    Version [pk, name: "PK_economy_reserve_heads"]
    IsActive [unique, name: "ux_economy_reserve_heads_active"]
    AuthorizationEpoch [unique, name: "ux_economy_reserve_heads_authorization_epoch"]
  }
}

Table "economy_risk_counters" {
  "Id" uuid [not null]
  "Dimension" integer [not null]
  "SubjectHash" "character varying(128)" [not null]
  "Operation" integer [not null]
  "Currency" integer [not null]
  "WindowStartedAt" timestamp [not null]
  "WindowEndsAt" timestamp [not null]
  "CounterVersion" bigint [not null]
  "MaxUnits" bigint [not null]
  "UsedUnits" bigint [not null]
  "UpdatedAt" timestamp [not null]

  Checks {
    `"CounterVersion" > 0 AND "MaxUnits" > 0 AND "UsedUnits" >= 0 AND "UsedUnits" <= "MaxUnits"` [name: 'ck_economy_risk_counters_bounds']
    `"WindowEndsAt" > "WindowStartedAt"` [name: 'ck_economy_risk_counters_window']
  }

  Indexes {
    Id [pk, name: "PK_economy_risk_counters"]
    (Dimension, SubjectHash, Operation, Currency, WindowStartedAt) [unique, name: "ux_economy_risk_counters_scope_window"]
  }
}

Table "economy_source_stamps" {
  "Id" uuid [not null]
  "SourceKind" "character varying(100)" [not null]
  "InternalSourceId" "character varying(256)" [not null]
  "SourceLegId" "character varying(256)" [not null]
  "Provider" "character varying(100)"
