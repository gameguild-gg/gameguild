Table "content_interaction_events" {
  "Id" uuid [not null]
  "InteractionId" uuid [not null]
  "Type" integer [not null]
  "OccurredAt" timestamp [not null]
  "DurationSeconds" integer
  "PositionSeconds" numeric(12,3)
  "ProgressPercentage" numeric(5,2)
  "Payload" text
  "IdempotencyKey" "character varying(128)"
  "Version" integer [not null]
  "CreatedAt" timestamp [not null]
  "UpdatedAt" timestamp [not null]
  "DeletedAt" timestamp
  "TenantId" uuid

  Checks {
    `"DurationSeconds" IS NULL OR "DurationSeconds" > 0` [name: 'CK_content_interaction_events_DurationSeconds_Positive']
    `"PositionSeconds" IS NULL OR "PositionSeconds" >= 0` [name: 'CK_content_interaction_events_PositionSeconds_NonNegative']
    `"ProgressPercentage" IS NULL OR ("ProgressPercentage" >= 0 AND "ProgressPercentage" <= 100)` [name: 'CK_content_interaction_events_ProgressPercentage_Range']
    `"Type" BETWEEN 0 AND 8` [name: 'CK_content_interaction_events_Type_Valid']
  }

  Indexes {
    Id [pk, name: "PK_content_interaction_events"]
    (InteractionId, IdempotencyKey) [unique, name: "IX_content_interaction_events_InteractionId_IdempotencyKey"]
